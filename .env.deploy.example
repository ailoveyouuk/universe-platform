# Copy this file to .env.deploy and fill in real values.
# .env.deploy is gitignored -- never commit it, never put it back in OneDrive.

# -- Database (fresh Postgres server -- provision this first) --
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-SERVER.postgres.database.azure.com:5432/renewables_connect?sslmode=require"

# -- Azure AD --
AZURE_AD_TENANT_ID="your-tenant-id"
AZURE_AD_CLIENT_ID="your-client-id"

# -- Azure Container Registry --
ACR_NAME="your-registry-name"
ACR_PASSWORD="your-registry-admin-password"

# -- Deploy target --
RESOURCE_GROUP="rg-renewables-connect"
CONTAINER_ENV="rc-container-env"

# -- App URLs (for CORS) --
LEARNER_APP_URL="https://your-learner-app.azurestaticapps.net"
INSTITUTION_APP_URL="https://your-institution-app.azurestaticapps.net"
EMPLOYER_APP_URL="https://your-employer-app.azurestaticapps.net"
ADMIN_APP_URL="https://your-admin-app.azurestaticapps.net"
