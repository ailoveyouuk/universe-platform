# Shared database (Azure SQL Database) — one database, every tenant's data,
# isolated by organizationId + Row-Level Security.
DATABASE_URL="sqlserver://<server>.database.windows.net:1433;database=<db>;user=<user>;password=<password>;encrypt=true;trustServerCertificate=false"

# Universe Insights — a SEPARATE Azure SQL database (packages/insights-db)
# holding only anonymized, cross-tenant aggregated pricing data. Deliberately
# a different database/connection than DATABASE_URL above — see
# packages/insights-db/prisma/schema.prisma and architecture-decisions.md,
# "Anonymized cross-tenant insights" (2026-09-24).
INSIGHTS_DATABASE_URL="sqlserver://<server>.database.windows.net:1433;database=universe-insights;user=<user>;password=<password>;encrypt=true;trustServerCertificate=false"
# Secret used to HMAC-hash organizationId into AggregatedProductPrice.sourceHash
# (packages/insights-db/src/aggregate-etl.ts) — one-way, lets the query layer
# count distinct contributing orgs for the minimum-cohort-size check without
# ever storing which orgs they are. Generate a long random value and store it
# in Key Vault for real environments; changing it invalidates the ability to
# de-duplicate/compare hashes against previously-written rows.
INSIGHTS_HASH_SECRET=""

# Universe CIAM tenant (Microsoft Entra External ID) — a DEDICATED identity
# tenant for Universe, separate from any client organization's own corporate
# Entra ID tenant. Client/partner organization users sign in here; no
# client's own corporate directory is ever touched by this.
UNIVERSE_CIAM_TENANT_ID=""
# The tenant's subdomain — the part before ".ciamlogin.com"/".onmicrosoft.com"
# (e.g. "universeplatform" for the real tenant). Required so the API can
# resolve the tenant's real ciamlogin.com OIDC discovery document instead of
# falling back to the plain login.microsoftonline.com pattern — see
# packages/auth/src/verifyToken.ts.
UNIVERSE_CIAM_TENANT_SUBDOMAIN=""
UNIVERSE_CIAM_CLIENT_ID=""
UNIVERSE_CIAM_CLIENT_SECRET=""
# Expected `aud` claim on API access tokens. IMPORTANT: this is the API app
# registration's bare Application (client) ID GUID — NOT its Application ID
# URI (api://...). The api://... form is only ever used as the *scope*
# string a client requests a token for (see API_SCOPES in
# packages/auth/src/msalConfig.ts); Entra never puts it in a token's own
# `aud` claim. Getting this wrong (pasting the api://... URI here) makes
# every real token fail verification — see claude/azure-infra-notes.md in
# the Claude project for the 2026-09-26 incident where exactly this happened
# in the deployed Container App.
UNIVERSE_CIAM_API_AUDIENCE=""

# Frontend (Next.js) — same CIAM tenant, public client values only.
NEXT_PUBLIC_UNIVERSE_CIAM_TENANT_ID=""
NEXT_PUBLIC_UNIVERSE_CIAM_CLIENT_ID=""
NEXT_PUBLIC_UNIVERSE_CIAM_TENANT_SUBDOMAIN=""
NEXT_PUBLIC_REDIRECT_URI="http://localhost:3000"

# API service
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
API_PORT=4000
