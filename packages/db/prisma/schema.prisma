// ---------------------------------------------------------------------------
// Compliance scaffolding — added 2026-10-07, see
// claude/compliance-standards-gap-analysis.md. Generic, organisation-
// agnostic infrastructure (same "core scaffolding, not org-specific
// process bloat" principle sop-driven-quality-roadmap.md already
// established for the Evidence work), not features tied to any one
// stakeholder's SOPs.
// ---------------------------------------------------------------------------

/// Gap 1 — a generic, field-level audit trail. ALCOA+/FDA 21 CFR Part 11/
/// EU Annex 11/MHRA GxP Data Integrity Guidance all require that a changed
/// or deleted value's PREVIOUS state be retained, attributable to a
/// specific individual, timestamped, and (where relevant) carry a reason —
/// a bare `updatedAt` column satisfies none of that, since the prior value
/// is simply gone. Before this, the only tables with any change history at
/// all were ProjectStatusHistory (status field only) and
/// PartnerApprovalHistory (approval decisions only, and — see that
/// model's own fix above — not even written to by any service yet).
///
/// Deliberately ONE ROW PER CHANGED FIELD, not one row per request/mutation
/// — so "every past value of this one field" is a simple, indexed query
/// (tableName + recordId + fieldName) rather than a scan through
/// differently-shaped per-request snapshots. Written from the shared
/// `recordFieldChanges()` helper (apps/api/src/common/audit-log.ts) inside
/// the SAME withTenantContext transaction as the write it's auditing, so a
/// rolled-back write can never leave an orphaned log entry (or vice versa).
///
/// Never updated or deleted by application code once written — there is
/// deliberately no update/delete path in the service layer for this model,
/// which is itself the "audit trail cannot be disabled by standard users"
/// control MHRA's guidance calls for. (A genuinely separate, future
/// platform-staff-only correction mechanism, if one is ever needed, should
/// be a NEW row referencing the old one, never an edit/delete of history.)
model FieldChangeLog {
  id                     String       @id @default(uuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// The Prisma @@map table name being audited, e.g. "projects",
  /// "project_lines", "partners" — free text by design (not an enum),
  /// since this log is meant to cover every tenant table over time
  /// without a schema change each time a new one is wired in.
  tableName              String
  recordId               String
  fieldName              String
  /// Stringified before/after values (Dates as ISO, numbers/decimals via
  /// their own toString()) — see diffForAudit()'s normalize() helper. Not
  /// typed per-field on purpose: a generic log can't know every table's
  /// column types, and a human-readable string is sufficient for an audit
  /// review, which is this table's entire purpose.
  oldValue               String?      @db.NVarChar(Max)
  newValue               String?      @db.NVarChar(Max)
  changedById            String?
  changedAt              DateTime     @default(now())
  /// Free-text reason, where the caller supplied one (not every change
  /// has or needs one — a required-reason policy, if wanted, belongs in
  /// the DTO/service layer, not enforced here).
  reason                 String?      @db.NVarChar(Max)
  /// UI | API | MIGRATION | SYSTEM — which path produced this change.
  /// Defaults to "API" (recordFieldChanges()'s default) since that's the
  /// only path wired in today; MIGRATION/SYSTEM are reserved for a
  /// one-off backfill or scheduled job that changes data without a human
  /// request behind it.
  source                 String       @default("API")
  /// Gap 2 — when this row represents an approval/verification action
  /// ("e-signature" in Part 11/Annex 11 terms), the exact certification
  /// statement text shown to the signer at that moment, captured verbatim.
  /// Null for an ordinary field edit with no certification semantics.
  certificationStatement String?      @db.NVarChar(Max)

  @@index([organizationId])
  @@index([tableName, recordId])
  @@index([changedAt])
  @@map("field_change_log")
}

/// Gap 4 — a minimal, generic risk-assessment record (ICH Q9 Quality Risk
/// Management / ISO 14971 / ISO 31000's shared shape: identify, assess,
/// mitigate, assign an owner, review periodically). Deliberately NOT the
/// full Deviation/CAPA/Recall process-management suite the first draft of
/// sop-driven-quality-roadmap.md proposed and then dropped as "a single
/// organisation's own SOP-driven process, not core platform" — this is lighter-weight
/// core scaffolding any organisation can use for its own risk register,
/// the same way EvidenceStandardDefinition generalised certification
/// tracking rather than hardcoding any one organisation's own list.
model RiskAssessment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// What this risk is about — a free-text subject type ("PARTNER",
  /// "PROJECT", "PRODUCT_BATCH", ...) + id pair, the same
  /// generic-polymorphic-reference convention as FieldChangeLog's
  /// tableName/recordId, rather than a nullable FK per possible subject
  /// (which would need a schema change every time a new subject type
  /// comes up).
  subjectType    String
  subjectId      String
  title          String
  description    String?      @db.NVarChar(Max)
  /// LOW | MEDIUM | HIGH | CRITICAL — free text for now, same convention
  /// as Partner.riskTier, rather than a hardcoded enum.
  severity       String
  /// LOW | MEDIUM | HIGH — likelihood of the risk materialising.
  likelihood     String
  /// Free-text mitigation/control plan.
  mitigation     String?      @db.NVarChar(Max)
  ownerId        String?
  owner          User?        @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// OPEN | MITIGATED | ACCEPTED | CLOSED.
  status         String       @default("OPEN")
  reviewDate     DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([subjectType, subjectId])
  @@index([reviewDate])
  @@map("risk_assessments")
}

/// Gap 7 (compliance-standards-gap-analysis.md) — a minimal controlled-
/// document register for an organisation's own SOPs/policies: the
/// artifacts this whole GDP/compliance build exists to let a stakeholder
/// evidence compliance AGAINST, but which Universe itself had no module
/// to version-control as living documents. Deliberately thin — version
/// number, effective date, an approval attribution, and a supersedes/
/// supersededBy chain for current-vs-superseded state — not a general
/// document-management system with check-in/check-out or review
/// workflows, same "core scaffolding, not a full process suite"
/// principle as every other gap closed in this build.
model ControlledDocument {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title          String
  /// Free text, same convention as EvidenceStandardDefinition.category —
  /// e.g. "QUALITY_MANUAL", "SOP", "POLICY", "WORK_INSTRUCTION".
  category       String
  /// Free-text version label (e.g. "1.0", "2.3", "v4") rather than a
  /// strict semver — real-world SOPs are often versioned inconsistently,
  /// and this register is meant to record what an organisation
  /// actually calls its own version, not impose a new scheme on it.
  version        String
  effectiveDate  DateTime?
  /// The prior version this one replaces, and the reverse pointer — a
  /// one-directional chain per document lineage, same self-relation
  /// convention as User.invitedBy/invitedUsers above. supersededById is
  /// set on the OLD row when a NEW version is created referencing it via
  /// supersedesId, keeping "is this the current version" a simple null
  /// check (isCurrent = supersededById === null) rather than a separate
  /// status field that could drift out of sync with the chain itself.
  /// Physical DB implementation note (2026-10-08, 20261008130000): this
  /// is a FILTERED unique index (WHERE supersedesId IS NOT NULL) at the
  /// database level, not a plain UNIQUE constraint — SQL Server treats
  /// multiple NULLs as duplicates under a plain unique constraint, which
  /// blocked any organisation from having more than one controlled
  /// document with no predecessor. The @unique attribute below is kept
  /// as-is since it still correctly describes the 1:1 relationship
  /// Prisma needs for supersedes/supersededBy typing.
  supersedesId   String?             @unique
  supersedes     ControlledDocument? @relation("ControlledDocumentSupersedes", fields: [supersedesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersededBy   ControlledDocument? @relation("ControlledDocumentSupersedes")
  approvedById   String?
  approvedBy     User?               @relation(fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedAt     DateTime?
  /// Optional link to the actual file (Blob Storage, same as every other
  /// document reference in the schema) — nullable since a register entry
  /// can exist (e.g. recording a historical version) before or without
  /// the file itself being uploaded.
  documentId     String?
  document       ProjectDocument?    @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([organizationId, category])
  @@map("controlled_documents")
}

// ---------------------------------------------------------------------------
// GDP gap-closing build (added 2026-10-07) — closes the two gaps identified
// as genuinely missing for Good Distribution Practice in
// claude/compliance-standards-gap-analysis.md's "GDP compliance assessment"
// addendum, both already fully designed in sop-driven-quality-roadmap.md:
//
// Gap 3 — Standards & Evidence scaffolding: EvidenceStandardDefinition +
// StakeholderEvidenceRecord, replacing the hardcoded PartnerCertification/
// PartnerCompanyCheck type lists with a per-organisation configurable
// catalog, and gating Partner.approvalStatus on mandatory evidence being
// VERIFIED. (The roadmap doc also proposed a separate OnboardingRequirementSet
// table; deliberately NOT built as its own table here — a "requirement set"
// for a stakeholder type is just EvidenceStandardDefinition rows filtered by
// appliesToStakeholderTypes + isMandatory for the org, so a materialized
// join table would only duplicate that filter, not add new information. See
// EvidenceService.getApplicableStandards/getGateStatus.)
//
// Gaps 5/6 — batch traceability + cold-chain temperature logging:
// ProductBatch promotes the batch from a free-text field on ProjectLine to
// a first-class, searchable entity; BatchTemperatureLog gives data-logger
// readings/excursions their own child table instead of one flat field per
// line. Carrier/route qualification (also named in Gap 5) is deliberately
// NOT a new table — it's modeled as an EvidenceStandardDefinition row
// scoped to the FREIGHT_FORWARDER stakeholder type (category REGULATORY,
// with reVerificationFrequencyMonths driving requalification), reusing Gap
// 3's infrastructure rather than building a second, parallel mechanism for
// the same "qualified until a date, then needs re-checking" shape.
// ---------------------------------------------------------------------------

/// Gap 3 — the configurable catalog of standards/evidence an organisation
/// can require from its stakeholders. Replaces the hardcoded allowed-value
/// lists on PartnerCertification.type/PartnerCompanyCheck.checkType with a
/// real, per-organisation, admin-editable table — demo MHRA/GDP/ISO/
/// WHO-MQAS requirements become the first seeded rows, not a
/// blueprint baked into code for every tenant. See
/// sop-driven-quality-roadmap.md "Proposed core scaffolding", item 1.
model EvidenceStandardDefinition {
  id                            String       @id @default(uuid())
  organizationId                String
  organization                  Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name                          String
  description                   String?      @db.NVarChar(Max)
  /// QUALITY | BUSINESS | FINANCIAL | REGULATORY | INSURANCE | OTHER — see
  /// EvidenceStandardCategory in packages/db/src/enums.ts.
  category                      String
  /// Comma-joined PartnerRoleType values this standard applies to (e.g.
  /// "MANUFACTURER,SUPPLIER") — same multiselect-as-comma-joined-string
  /// convention as ClientDetail.productCategoryLicenses, since the SQL
  /// Server connector has no native array/set column type.
  appliesToStakeholderTypes     String       @db.NVarChar(Max)
  /// DOCUMENT | CHECK — see EvidenceType in packages/db/src/enums.ts;
  /// drives which fields the frontend's "log evidence" form shows.
  evidenceType                  String
  /// Drives gating: Partner.approvalStatus cannot move to APPROVED while
  /// any isMandatory standard applicable to that partner's active roles
  /// has no StakeholderEvidenceRecord with status VERIFIED (and, if
  /// requiresExpiry, a non-expired one) — see EvidenceService.getGateStatus.
  isMandatory                   Boolean      @default(true)
  requiresExpiry                Boolean      @default(false)
  /// When set, a VERIFIED record against this standard is flagged as due
  /// for re-verification this many months after its own verifiedAt — the
  /// generic mechanism behind "annual Bona Fide recheck", "annual customer
  /// requalification", and freight-forwarder route requalification alike,
  /// rather than a bespoke field/feature per case.
  reVerificationFrequencyMonths Int?
  active                        Boolean      @default(true)
  sortOrder                     Int          @default(0)
  createdAt                     DateTime     @default(now())
  updatedAt                     DateTime     @updatedAt

  evidenceRecords StakeholderEvidenceRecord[]

  @@index([organizationId])
  @@index([organizationId, active])
  @@map("evidence_standard_definitions")
}

/// Gap 3 — one logged piece of evidence against a standard, for one
/// partner. Generalises PartnerCertification (DOCUMENT shape) and
/// PartnerCompanyCheck (CHECK shape) into a single table keyed to a
/// catalog row instead of a hardcoded type string. Existing
/// PartnerCertification/PartnerCompanyCheck rows are NOT migrated into
/// this table by this change — both tables stay exactly as they are for
/// existing data (see sop-driven-quality-roadmap.md's suggested
/// build order, item 5, for the planned follow-up migration); this is the
/// new write path going forward, usable immediately for any standard an
/// org adds to its own catalog.
model StakeholderEvidenceRecord {
  id              String                     @id @default(uuid())
  organizationId  String
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partnerId       String
  partner         Partner                    @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  standardId      String
  standard        EvidenceStandardDefinition @relation(fields: [standardId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referenceNumber String?
  issuingBody     String?
  issuedDate      DateTime?
  expiryDate      DateTime?
  /// Only meaningful for evidenceType == CHECK — YES | NO | NOT_APPLICABLE,
  /// same convention as PartnerCompanyCheck.result.
  result          String?
  documentId      String?
  document        ProjectDocument?           @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// PENDING | VERIFIED | EXPIRED | REJECTED — see EvidenceRecordStatus.
  status          String                     @default("PENDING")
  verifiedById    String?
  verifiedAt      DateTime?
  notes           String?                    @db.NVarChar(Max)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([organizationId])
  @@index([partnerId])
  @@index([standardId])
  @@index([expiryDate])
  @@index([organizationId, status, createdAt])
  @@map("stakeholder_evidence_records")
}

/// Gaps 5/6 — promotes a product batch from a free-text field on
/// ProjectLine to a first-class, searchable, tenant-scoped entity, so
/// "every place batch X was shipped, and was it kept in spec" is one
/// indexed query instead of a manual text search across project lines.
/// See sop-driven-quality-roadmap.md "Full batch-level traceability for
/// pharma projects".
model ProductBatch {
  qualityComplaints QualityComplaint[]
  id                             String         @id @default(uuid())
  organizationId                 String
  organization                   Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productMasterId                String?
  productMaster                  ProductMaster? @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manufacturerId                 String?
  manufacturer                   Partner?       @relation(fields: [manufacturerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batchNumber                    String
  manufacturedDate               DateTime?
  expiryDate                     DateTime?
  storageConditions              String?
  /// Which regulatory pathway qualified this batch — same allowed values
  /// as ProjectLine.qualificationPathway (WHO PQ / SRA / ERP), moved here
  /// as the canonical per-batch record rather than re-entered per line.
  qualificationPathway           String?
  qualificationPathwayExpiryDate DateTime?
  /// Marketing Authorization / Product License number.
  maPl                           String?
  /// ACTIVE | QUARANTINED | EXPIRED | WITHDRAWN — see ProductBatchStatus.
  /// Tracked once per batch instead of per line, so quarantining a batch
  /// is a single update that's visible everywhere that batch is referenced.
  status                         String         @default("ACTIVE")
  notes                          String?        @db.NVarChar(Max)
  createdById                    String?
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @updatedAt

  projectLines    ProjectLine[]
  temperatureLogs BatchTemperatureLog[]

  @@index([organizationId])
  @@index([organizationId, batchNumber])
  @@index([productMasterId])
  @@index([manufacturerId])
  @@index([status])
  @@map("product_batches")
}

/// Gaps 5/6 — one data-logger reading/excursion event against a batch.
/// Previously a single flat dataLoggerReference/dataLoggerReportReviewed/
/// excursionReview field-set per ProjectLine, which could not hold more
/// than one logger event per shipment; this gives cold-chain monitoring
/// its own child table, scoped to the batch (the WHO/EU GDP-relevant unit)
/// rather than the commercial line.
model BatchTemperatureLog {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productBatchId  String
  productBatch    ProductBatch @relation(fields: [productBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Optional — which specific shipment/delivery this reading belongs to,
  /// when the batch has been linked to one or more ProjectLines.
  projectLineId   String?
  loggerReference String?
  /// Free-text summary of the logger's reading/report for now (e.g. "2-8C
  /// maintained throughout, no excursions" or "+11C for 40min at hr 6") —
  /// a structured min/max/duration time-series is a larger, separate
  /// build (full IoT logger ingestion) this doesn't attempt.
  readingSummary  String?      @db.NVarChar(Max)
  hasExcursion    Boolean      @default(false)
  excursionNotes  String?      @db.NVarChar(Max)
  reviewed        Boolean      @default(false)
  reviewedById    String?
  reviewedAt      DateTime?
  recordedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())

  @@index([organizationId])
  @@index([productBatchId])
  @@map("batch_temperature_logs")
}

/// An in-app notification OR action item addressed to ONE user (added
/// 2026-10-16). Account-aware by construction: every row belongs to a
/// recipient and the recipient's organisation, and the API only ever reads
/// rows WHERE recipientUserId = the signed-in user. Tenant-scoped (RLS).
///
/// Two flavours share the table:
///  - plain notifications (requiresAction = false): "you were added to
///    project X", "project Y moved to Awarded". Read/unread only.
///  - actions (requiresAction = true): something a colleague asked this user
///    to do. actionStatus OPEN -> DONE (completedAt set), optional dueDate.
///
/// kind (free text, app-defined): PROJECT_ASSIGNED, PROJECT_STATUS_CHANGED,
/// ACTION_ASSIGNED, ACTION_COMPLETED. category groups them for the user's
/// "Actions" view: PROJECT (more to come: QUALITY, LOGISTICS, RISK).
/// link is an in-app path ("/projects/detail?id=..."); subjectType/subjectId
/// identify the record it is about. Rows are never hard-deleted by the app.
model Notification {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipientUserId String
  recipient       User         @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorUserId     String?
  actor           User?        @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kind            String
  category        String       @default("PROJECT")
  title           String       @db.NVarChar(300)
  body            String?      @db.NVarChar(1000)
  link            String?      @db.NVarChar(500)
  subjectType     String?
  subjectId       String?
  requiresAction  Boolean      @default(false)
  /// OPEN | DONE — only set when requiresAction.
  actionStatus    String?
  dueDate         DateTime?
  readAt          DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())

  @@index([recipientUserId, readAt])
  @@index([recipientUserId, requiresAction, actionStatus])
  @@index([organizationId])
  @@map("notifications")
}

/// Additional identifiers for one catalogue product (added 2026-10-18): a product can carry many GTINs, manufacturer part
/// numbers, UDI-DIs, NDCs and other codes. Shared (no organizationId), like product_master; deactivated, never deleted.
model ProductIdentifier {
  id              String        @id @default(uuid())
  productMasterId String
  productMaster   ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// GTIN | MPN | UDI_DI | NDC | ATC | GMDN | OTHER
  identifierType  String
  value           String
  label           String?
  /// Packaging level this identifier belongs to: UNIT | INNER | OUTER | PALLET (step 3b)
  packagingLevel  String?
  unitsPerPack    Int?
  isActive        Boolean       @default(true)
  createdById     String?
  createdAt       DateTime      @default(now())

  @@unique([productMasterId, identifierType, value])
  @@index([identifierType, value])
  @@map("product_identifiers")
}

/// Append-only change history for the shared catalogue (added 2026-10-18). FieldChangeLog is tenant-scoped, so it could
/// not record platform-staff edits to the shared product_master row; this shared table records every applied change
/// (staff edit, ratified amendment, import, creation) with who, from which organisation, why and the resulting version.
/// Names are denormalised on purpose: the user and organisation rows are tenant-protected and may later change.
model ProductMasterChange {
  id                        String        @id @default(uuid())
  productMasterId           String
  productMaster             ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version                   Int
  fieldName                 String
  oldValue                  String?       @db.NVarChar(Max)
  newValue                  String?       @db.NVarChar(Max)
  /// CREATE | STAFF_EDIT | AMENDMENT_RATIFIED | IMPORT | SYSTEM
  source                    String
  reason                    String?       @db.NVarChar(Max)
  amendmentId               String?
  changedById               String?
  changedByName             String?
  changedByOrganizationId   String?
  changedByOrganizationName String?
  changedAt                 DateTime      @default(now())

  @@index([productMasterId, changedAt])
  @@map("product_master_changes")
}

/// Structured regulatory registration of a catalogue product (added 2026-10-18, Product Database step 2). SHARED fact, like
/// product_master: what is registered with which authority, under which reference, until when. Contributed by platform staff
/// or by an organisation's users (verificationLevel CONTRIBUTED until platform staff mark it SOURCE_VERIFIED against the
/// authority's own record). Never deleted: retired via isArchived. Each organisation's own check lives in
/// ProductRegistrationVerification (tenant-scoped).
model ProductRegulatoryRegistration {
  id                            String         @id @default(uuid())
  /// Exactly one of productMasterId (a variant) or productFamilyId (applies to every variant of the family) is set.
  productMasterId               String?
  productMaster                 ProductMaster? @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productFamilyId               String?
  productFamily                 ProductFamily? @relation(fields: [productFamilyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// WHO_PQ | WHO_EUL | FDA | EU_CE | EU_MDR | EU_IVDR | EMA | MHRA | SRA | NATIONAL | OTHER — RegistrationAuthority.
  authority                     String
  /// Pathway/scheme, e.g. "510(k)", "NDA", "ANDA", "Centralised procedure", "Annex IX", "PQ medicines".
  scheme                        String?
  referenceNumber               String
  /// Device/IVD class or listing category, where it applies.
  regulatoryClass               String?
  /// ISO alpha-2 country the registration applies to (null = supranational, e.g. EU or WHO).
  countryCode                   String?
  /// Registration/marketing-authorisation holder or applicant, as stated by the authority.
  holderName                    String?
  issueDate                     DateTime?
  expiryDate                    DateTime?
  /// ACTIVE | PENDING | SUSPENDED | WITHDRAWN | EXPIRED | REFUSED — RegistrationStatus. A past expiryDate is treated as expired by the API even if this is still ACTIVE.
  status                        String         @default("ACTIVE")
  sourceUrl                     String?
  notes                         String?        @db.NVarChar(Max)
  /// CONTRIBUTED | SOURCE_VERIFIED
  verificationLevel             String         @default("CONTRIBUTED")
  contributedByOrganizationId   String?
  contributedByOrganizationName String?
  contributedById               String?
  isSimulated                   Boolean        @default(false)
  isArchived                    Boolean        @default(false)
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  verifications ProductRegistrationVerification[]

  @@index([productMasterId, isArchived])
  @@index([productFamilyId, isArchived])
  @@index([expiryDate, status])
  @@index([authority, referenceNumber])
  @@map("product_regulatory_registrations")
}

/// An organisation's own check of a registration (added 2026-10-18) — the "checked and verified" audit record for its QA
/// staff. Tenant-scoped (RLS); append-only: a re-check adds a row, the newest row is the current position.
/// Product family (step 3b, 2026-10-18): the generic product above its variants. Every ProductMaster row is a variant (a
/// specific strength / pack size / GTIN set); a family holds what is common (name, brand, category, INN, class) and can carry
/// registrations and controlled documents that apply to all its variants. Shared catalogue data, not tenant-scoped.
model ProductFamily {
  id                      String   @id @default(uuid())
  name                    String
  category                String
  brand                   String?
  inn                     String?
  regulatoryClass         String?
  intendedUse             String?  @db.NVarChar(Max)
  description             String?  @db.NVarChar(Max)
  isSimulated             Boolean  @default(false)
  isArchived              Boolean  @default(false)
  addedByOrganizationId   String?
  addedByOrganizationName String?
  version                 Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  variants      ProductMaster[]
  registrations ProductRegulatoryRegistration[]
  documents     ProductDocument[]
  changes       ProductFamilyChange[]
  safetyNotices ProductSafetyNotice[]

  @@index([category])
  @@index([name])
  @@index([isSimulated, isArchived])
  @@map("product_families")
}

/// Audit trail for family-level changes (including registrations and documents attached to the family).
model ProductFamilyChange {
  id                        String        @id @default(uuid())
  productFamilyId           String
  productFamily             ProductFamily @relation(fields: [productFamilyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fieldName                 String
  oldValue                  String?       @db.NVarChar(Max)
  newValue                  String?       @db.NVarChar(Max)
  source                    String
  changedById               String?
  changedByName             String?
  changedByOrganizationId   String?
  changedByOrganizationName String?
  changedAt                 DateTime      @default(now())

  @@index([productFamilyId, changedAt])
  @@map("product_family_changes")
}

/// Controlled product-level documents (Product Database step 3, 2026-10-18): certificates, IFU/labelling, SDS,
/// specifications, CoA templates, test reports, technical file. Private to the organisation (RLS). Versioned by
/// supersession; never deleted (archivedAt). Approval is four-eyes: the approver cannot be the uploader.
model ProductDocument {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Exactly one of productMasterId (a variant) or productFamilyId (every variant of the family) is set.
  productMasterId String?
  productMaster   ProductMaster? @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productFamilyId String?
  productFamily   ProductFamily? @relation(fields: [productFamilyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Optional link to the registration this document evidences.
  registrationId  String?
  /// CERTIFICATE | IFU | LABELLING | SDS | SPECIFICATION | COA_TEMPLATE | TEST_REPORT | TECHNICAL_FILE | OTHER
  docType         String
  title           String
  version         String         @default("1.0")
  /// DRAFT | APPROVED | SUPERSEDED
  status          String         @default("DRAFT")
  effectiveDate   DateTime?
  expiryDate      DateTime?
  reviewDueDate   DateTime?
  supersedesId    String?
  blobName        String?
  fileName        String?
  fileSizeBytes   Int?
  mimeType        String?
  /// Blob ETag at confirmation: an integrity reference for the stored file.
  blobEtag        String?
  /// NOT_SCANNED | CLEAN | INFECTED (from Defender for Storage blob tags, checked at confirmation and on download)
  scanStatus      String         @default("NOT_SCANNED")
  notes           String?        @db.NVarChar(Max)
  uploadedById    String
  uploadedBy      User           @relation("ProductDocumentUploader", fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedById    String?
  approvedBy      User?          @relation("ProductDocumentApprover", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedAt      DateTime?
  isSimulated     Boolean        @default(false)
  archivedAt      DateTime?
  archivedById    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId, productMasterId, archivedAt])
  @@index([organizationId, expiryDate])
  @@index([productMasterId])
  @@index([organizationId, productFamilyId, archivedAt])
  @@map("product_documents")
}

model ProductRegistrationVerification {
  id                    String                        @id @default(uuid())
  organizationId        String
  organization          Organization                  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  registrationId        String
  registration          ProductRegulatoryRegistration @relation(fields: [registrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// VERIFIED | NOT_APPLICABLE | ISSUE_FOUND — RegistrationVerificationOutcome.
  outcome               String
  /// The jurisdiction the check was made for (free text, e.g. "Kenya" or "UK/MHRA").
  jurisdiction          String?
  notes                 String?                       @db.NVarChar(Max)
  nextReverificationDue DateTime?
  verifiedById          String
  verifiedBy            User                          @relation(fields: [verifiedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verifiedAt            DateTime                      @default(now())

  @@index([organizationId, registrationId, verifiedAt])
  @@index([organizationId, nextReverificationDue])
  @@map("product_registration_verifications")
}

/// Safety notice / recall / field safety notice for a catalogue product (Product Database step 4, 2026-10-18). SHARED fact like
/// product_regulatory_registrations: one record per notice, attached to a variant or to a family (applies to every variant).
/// Contributed by platform staff or an organisation's QA users; never deleted (CLOSED / isArchived). Each organisation's own
/// "checked / verified" review is ProductSafetyNoticeReview (tenant-scoped).
model ProductSafetyNotice {
  id                            String         @id @default(uuid())
  productMasterId               String?
  productMaster                 ProductMaster? @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productFamilyId               String?
  productFamily                 ProductFamily? @relation(fields: [productFamilyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// RECALL | FIELD_SAFETY_NOTICE | SAFETY_ALERT | FALSIFIED_ALERT | SUPPLY_ALERT — SafetyNoticeType.
  noticeType                    String
  /// CRITICAL (e.g. class I recall) | HIGH (class II) | MEDIUM (class III) | LOW (advisory) — SafetyNoticeSeverity.
  severity                      String
  /// The issuing body: same list as RegistrationAuthority (FDA, MHRA, WHO_PQ, EMA, NATIONAL, OTHER...) or MANUFACTURER.
  authority                     String
  referenceNumber               String?
  title                         String
  summary                       String         @db.NVarChar(Max)
  actionRequired                String?        @db.NVarChar(Max)
  /// Affected batch / lot numbers as stated in the notice (free text, comma or line separated).
  affectedBatches               String?        @db.NVarChar(Max)
  /// ISO alpha-2 country codes, comma separated; empty = worldwide / not stated.
  countryCodes                  String?
  issueDate                     DateTime
  /// OPEN | CLOSED — closing records closedDate and a reason; reopening is allowed.
  status                        String         @default("OPEN")
  closedDate                    DateTime?
  closedReason                  String?        @db.NVarChar(Max)
  sourceUrl                     String?
  verificationLevel             String         @default("CONTRIBUTED")
  contributedByOrganizationId   String?
  contributedByOrganizationName String?
  contributedById               String?
  isSimulated                   Boolean        @default(false)
  isArchived                    Boolean        @default(false)
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  reviews ProductSafetyNoticeReview[]

  @@index([productMasterId, isArchived, status])
  @@index([productFamilyId, isArchived, status])
  @@index([status, severity, issueDate])
  @@map("product_safety_notices")
}

/// An organisation's own review of a safety notice (Product Database step 4): "checked, no impact" / "not applicable" /
/// "action taken" / "affected". Tenant-scoped (RLS), append-only: a later review adds a row, the newest is current.
model ProductSafetyNoticeReview {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  noticeId       String
  notice         ProductSafetyNotice @relation(fields: [noticeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// CHECKED_NO_IMPACT | NOT_APPLICABLE | ACTION_TAKEN | AFFECTED — SafetyNoticeReviewOutcome.
  outcome        String
  notes          String?             @db.NVarChar(Max)
  reviewedById   String
  reviewedBy     User                @relation("SafetyNoticeReviewer", fields: [reviewedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedAt     DateTime            @default(now())

  @@index([organizationId, noticeId, reviewedAt])
  @@map("product_safety_notice_reviews")
}

/// Regulatory watch (Product Database step 4b, 2026-10-18): one row per recall / alert published by an external regulator, fetched
/// daily by the watch job and stored idempotently on (source, sourceReference). SHARED public data; never deleted (source status
/// moves to CLOSED). Real items are matched only against real (non-simulated) catalogue products; simulated demo items are
/// flagged isSimulated and stay inside the demo organisation.
model RegulatoryWatchItem {
  id              String   @id @default(uuid())
  /// OPENFDA_DEVICE | OPENFDA_DRUG | MHRA_ALERTS — RegulatoryWatchSource.
  source          String
  /// The regulator's own identifier (e.g. recall number Z-0004-2027, or the GOV.UK path).
  sourceReference String
  /// FDA | MHRA ...
  authority       String
  /// RECALL | SAFETY_ALERT | FIELD_SAFETY_NOTICE | FALSIFIED_ALERT — same values as SafetyNoticeType.
  noticeType      String
  /// CRITICAL | HIGH | MEDIUM | LOW — SafetyNoticeSeverity.
  severity        String
  title           String
  summary         String   @db.NVarChar(Max)
  actionRequired  String?  @db.NVarChar(Max)
  /// Product description and code/lot information as published, used for matching.
  affectedText    String?  @db.NVarChar(Max)
  firmName        String?
  countryCodes    String?
  issueDate       DateTime
  /// OPEN | CLOSED as reported by the source.
  status          String   @default("OPEN")
  url             String?
  rawHash         String
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  isSimulated     Boolean  @default(false)

  matches RegulatoryWatchMatch[]

  @@unique([source, sourceReference])
  @@index([issueDate])
  @@index([isSimulated, status])
  @@map("regulatory_watch_items")
}

/// A potential match between a watch item and a catalogue variant. ADVISORY ONLY: nothing is blocked until platform staff confirm,
/// which creates a ProductSafetyNotice (and so notifies the organisations that use the product). Dismissal keeps the row.
model RegulatoryWatchMatch {
  id              String              @id @default(uuid())
  itemId          String
  item            RegulatoryWatchItem @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productMasterId String
  productMaster   ProductMaster       @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// 0..1. Identifier matches score 0.9+, name-and-strength matches around 0.6.
  confidence      Float
  /// IDENTIFIER | NAME
  matchBasis      String
  matchDetail     String?
  /// PENDING | CONFIRMED | DISMISSED
  status          String              @default("PENDING")
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  reviewNotes     String?             @db.NVarChar(Max)
  safetyNoticeId  String?
  createdAt       DateTime            @default(now())

  @@unique([itemId, productMasterId])
  @@index([status, confidence])
  @@index([productMasterId, status])
  @@map("regulatory_watch_matches")
}

/// One execution of one watch connector: the auditable evidence that monitoring ran (GDP / QMS).
model RegulatoryWatchRun {
  id           String    @id @default(uuid())
  source       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  /// RUNNING | SUCCESS | FAILED
  status       String    @default("RUNNING")
  fetched      Int       @default(0)
  newItems     Int       @default(0)
  changedItems Int       @default(0)
  newMatches   Int       @default(0)
  error        String?   @db.NVarChar(Max)
  isSimulated  Boolean   @default(false)

  @@index([source, startedAt])
  @@map("regulatory_watch_runs")
}

/// Medicines that a country restricts from export and/or hoarding (Product Database, 2026-10-18). SHARED reference data.
/// The UK list is fetched daily from the DHSC/MHRA CSV (source UK_DHSC_CSV); other countries' restrictions have no single feed
/// and are curated by platform staff (source MANUAL) with a source link. Entries are never deleted: one that leaves the source
/// list is marked REMOVED with the date. Matching to products is by generic name, strength and form and is advisory: the legal
/// duty stays with the licence holder.
model ExportRestriction {
  id                     String    @id @default(uuid())
  /// ISO alpha-2 country whose export / hoarding rule this is (GB for the UK list).
  restrictingCountryCode String
  /// UK_DHSC_CSV | MANUAL
  source                 String
  /// Normalised "name|strength|form"; unique within a source.
  sourceKey              String
  medicineName           String
  /// "All" or a slash-separated list such as "1g/2g/500mg".
  strength               String?
  /// "All" or a pharmaceutical form as published.
  form                   String?
  /// EXPORT | HOARDING | BOTH — what the restriction covers.
  scope                  String    @default("BOTH")
  restrictionDate        DateTime?
  /// ACTIVE | REMOVED
  status                 String    @default("ACTIVE")
  removedAt              DateTime?
  sourceUrl              String?
  notes                  String?   @db.NVarChar(Max)
  addedByName            String?
  isSimulated            Boolean   @default(false)
  firstSeenAt            DateTime  @default(now())
  lastSeenAt             DateTime  @default(now())

  @@unique([source, restrictingCountryCode, sourceKey])
  @@index([restrictingCountryCode, status])
  @@map("export_restrictions")
}

/// Request to export the shared Universe catalogue (2026-10-18). The pooled catalogue is a platform asset: ordinary users can export
/// only what their own organisation contributed; anything wider needs a global admin (platform staff) to approve a request. Tenant-scoped
/// (the requesting organisation sees its own requests); platform staff read across organisations. Never deleted: decided requests stay as the record.
model DataExportRequest {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedById  String
  requestedBy    User         @relation("DataExportRequester", fields: [requestedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// CATALOGUE | REGISTRATIONS
  scope          String
  /// JSON text of the filters the requester wants applied (search, category, status...).
  filters        String?      @db.NVarChar(Max)
  reason         String       @db.NVarChar(Max)
  /// PENDING | APPROVED | REJECTED | DOWNLOADED | EXPIRED
  status         String       @default("PENDING")
  decidedById    String?
  decidedBy      User?        @relation("DataExportDecider", fields: [decidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decidedAt      DateTime?
  decisionNote   String?      @db.NVarChar(Max)
  /// An approval is good for one download until this time.
  approvedUntil  DateTime?
  downloadedAt   DateTime?
  rowCount       Int?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("data_export_requests")
}


// =============================================================================
// TENDER ISSUANCE & MANAGEMENT (design: docs/TENDER-APP-DESIGN.md, 2026-10-19)
// -----------------------------------------------------------------------------
// Step 1a. A tender is owned by the ISSUER organisation (organizationId). Registered organisations can see a
// published tender (and its lines, criteria, rules, documents and public clarifications) through database policies in
// infra/sql/tender-rls.sql, never as raw writable rows. Participant-owned rows (participation, eligibility checks,
// questions) name the issuer as counterparty so the issuer can read them. Only the owner writes a row, except
// tender_events (append-only, either party). Organisation ids on child tables are plain columns (no Prisma relation)
// to avoid a back-relation on Organization per table; the policies and services enforce them.
// Tender.type        — RFQ | INVITED | OPEN | FRAMEWORK | RATE_CONTRACT | DIRECT_NEGOTIATION
// Tender.visibility  — INVITED_ONLY | ELIGIBLE_ORGANISATIONS (every registered organisation can see it, eligibility explains the rest)
// Tender.status      — DRAFT | PUBLISHED | CLOSED | EVALUATION | AWARDED | CANCELLED | NO_AWARD
// TenderCriterion.kind — GATE (pass/fail) | SCORED (weighted)
// TenderCriterion.responseFormat — UPLOAD | TEXT | EITHER | PRICE | NUMBER | YES_NO
// TenderEligibilityRule.ruleType — ORG_TYPE | COUNTRY | PRODUCT_CATEGORY | QUALIFICATION | MIN_RATING | SANCTIONS_CLEAR
// TenderParticipation.status — INTERESTED | WITHDRAWN | BID_STARTED | BID_SUBMITTED
// TenderEligibilityCheck.outcome — ELIGIBLE | ALMOST | NOT_ELIGIBLE
// =============================================================================

model Tender {
  id                    String       @id @default(uuid())
  /// The issuing organisation.
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referenceNumber       String
  title                 String       @db.NVarChar(300)
  summary               String?      @db.NVarChar(Max)
  tenderType            String       @default("RFQ")
  visibility            String       @default("ELIGIBLE_ORGANISATIONS")
  /// Set true when published and never reset (the policies read it); status carries the lifecycle.
  isPublished           Boolean      @default(false)
  /// Denormalised from visibility so the database policy can read it: true when every registered organisation may see it.
  visibleToAll          Boolean      @default(true)
  status                String       @default("DRAFT")
  /// Same delimited form as Project.deliveryCountryCodes (",KE,GB,").
  deliveryCountryCodes  String?
  currency              String?      @db.Char(3)
  incoterm              String?
  /// Optional client the issuer tenders for (procurement agents).
  clientName            String?
  publishedAt           DateTime?
  clarificationDeadline DateTime?
  closingAt             DateTime?
  evaluationDueAt       DateTime?
  awardDueAt            DateTime?
  bidValidityDays       Int?
  contractStartDate     DateTime?
  /// Bid submission rules. Accepted upload formats are comma-separated extensions; paste-in text is the alternative route.
  acceptedFileTypes     String?      @default("pdf,docx,xlsx,csv")
  maxFileSizeMb         Int?         @default(25)
  allowTextSubmission   Boolean      @default(true)
  /// Reserved for the public teaser page (version 2).
  publicTeaser          Boolean      @default(false)
  /// Compliance options added 2026-10-19. timeZone is an IANA zone the issuer's dates are expressed in. standstill* is the optional
  /// pause between award decision and contract signature (off by default). publicNotice publishes a read-only notice to anyone
  /// without sign-in (off by default; never for simulated tenders). The two require* flags make bidders accept the integrity pledge
  /// and declare exclusion grounds when expressing interest (on by default).
  timeZone              String?
  standstillEnabled     Boolean      @default(false)
  standstillWorkingDays Int?
  publicNotice          Boolean      @default(false)
  requireIntegrityPledge     Boolean @default(true)
  requireExclusionDeclaration Boolean @default(true)
  /// Bidders may also complete locked Excel/Word templates instead of the online form (on by default).
  allowTemplateSubmission Boolean @default(true)
  /// Evaluation and award options (step 4, 2026-10-20). Emergency procurement and single-evaluator decisions must each carry a reason.
  emergencyProcurement  Boolean      @default(false)
  emergencyReason       String?      @db.NVarChar(1000)
  allowSingleEvaluator  Boolean      @default(false)
  singleEvaluatorReason String?      @db.NVarChar(1000)
  /// Framework agreement terms (step 7 part 2); only used when tenderType is FRAMEWORK.
  frameworkTermMonths   Int?
  frameworkCeiling      Decimal?     @db.Decimal(18, 2)
  /// DIRECT (first-ranked supplier) or ROTATION (supplier with fewest call-offs)
  frameworkCallOffMethod String?     @db.NVarChar(20)
  frameworkPriceHoldDays Int?
  /// Milestones, set by the issuer's actions and shown (without any bidder detail) to participants.
  bidsOpenedAt          DateTime?
  evaluationStartedAt   DateTime?
  scoringFinalisedAt    DateTime?
  awardedAt             DateTime?
  standstillEndsAt      DateTime?
  termsAndConditions    String?      @db.NVarChar(Max)
  cancelledReason       String?      @db.NVarChar(1000)
  isSimulated           Boolean      @default(false)
  archivedAt            DateTime?
  createdById           String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  lines         TenderLine[]
  criteria      TenderCriterion[]
  rules         TenderEligibilityRule[]
  invitations   TenderInvitation[]
  documents     TenderDocument[]
  clarifications TenderClarification[]
  addenda       TenderAddendum[]

  @@unique([organizationId, referenceNumber])
  @@index([organizationId, status])
  @@index([isPublished, status, closingAt])
  @@map("tenders")
}

model TenderLine {
  id                 String   @id @default(uuid())
  organizationId     String
  tenderId           String
  tender             Tender   @relation(fields: [tenderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Lots are modelled as a number and title on the line now; separate lot awards come later.
  lotNumber          Int?
  lotTitle           String?
  lineNumber         Int
  /// Catalogue product when known; free text otherwise.
  productMasterId    String?
  description        String   @db.NVarChar(500)
  specification      String?  @db.NVarChar(Max)
  quantity           Decimal? @db.Decimal(18, 3)
  unit               String?
  destinationCountryCode String? @db.Char(2)
  requiredRegistration   String?
  minShelfLifePercent    Int?
  coldChainRequired      Boolean @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenderId, lineNumber])
  @@index([organizationId])
  @@index([productMasterId])
  @@map("tender_lines")
}

model TenderCriterion {
  id               String   @id @default(uuid())
  organizationId   String
  tenderId         String
  tender           Tender   @relation(fields: [tenderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sortOrder        Int      @default(0)
  title            String   @db.NVarChar(300)
  description      String?  @db.NVarChar(Max)
  kind             String   @default("SCORED")
  /// Percentage weight for SCORED criteria (the scored weights should total 100).
  weight           Decimal? @db.Decimal(5, 2)
  isMandatory      Boolean  @default(true)
  responseFormat   String   @default("EITHER")
  /// Overrides the tender's accepted file types for this requirement.
  acceptedFileTypes String?
  /// MANUAL criteria are scored by evaluators; PRICE and LEAD_TIME are calculated from the bids (lowest = 100).
  metric           String   @default("MANUAL")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenderId, sortOrder])
  @@index([organizationId])
  @@map("tender_criteria")
}

model TenderEligibilityRule {
  id             String   @id @default(uuid())
  organizationId String
  tenderId       String
  tender         Tender   @relation(fields: [tenderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ruleType       String
  /// Comma-separated values the rule accepts (organisation types, ISO country codes, categories, qualification codes, minimum rating).
  ruleValue      String   @db.NVarChar(500)
  /// Plain-language explanation shown to organisations that do not meet it.
  explanation    String?  @db.NVarChar(500)
  isRequired     Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([tenderId])
  @@index([organizationId])
  @@map("tender_eligibility_rules")
}

/// An explicit invitation. Row owner is the issuer; the invited organisation is the counterparty and can read its own.
model TenderInvitation {
  id                    String   @id @default(uuid())
  organizationId        String
  tenderId              String
  tender                Tender   @relation(fields: [tenderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitedOrganizationId String
  invitedAt             DateTime @default(now())
  invitedById           String?
  /// Invited organisations that are not eligible by the rules may still bid.
  @@unique([tenderId, invitedOrganizationId])
  @@index([invitedOrganizationId])
  @@index([organizationId])
  @@map("tender_invitations")
}

model TenderDocument {
  id             String   @id @default(uuid())
  organizationId String
  tenderId       String
  tender         Tender   @relation(fields: [tenderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title          String   @db.NVarChar(300)
  docType        String   @default("SPECIFICATION")
  blobName       String?
  fileName       String?
  fileSizeBytes  Int?
  mimeType       String?
  uploadedById   String?
  uploadedAt     DateTime @default(now())
  archivedAt     DateTime?
  /// Versioning (2026-10-21): every version of one document shares a documentKey (the first version's id; null on older rows means the row is its own key).
  documentKey    String?
  version        Int      @default(1)
  /// Set when a newer version replaces this one. Superseded versions stay visible as history and downloadable.
  supersededAt   DateTime?
  description    String?  @db.NVarChar(1000)

  @@index([tenderId])
  @@index([organizationId])
  @@map("tender_documents")
}

/// An issuer's published answer, shared with every organisation that can see the tender; the asker is not named.
model TenderClarification {
  id             String   @id @default(uuid())
  organizationId String
  tenderId       String
  tender         Tender   @relation(fields: [tenderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// The question as published (anonymised/edited by the issuer).
  question       String   @db.NVarChar(Max)
  answer         String   @db.NVarChar(Max)
  /// The private question this answers, when there was one.
  sourceQuestionId String?
  answeredById   String?
  answeredAt     DateTime @default(now())

  @@index([tenderId, answeredAt])
  @@index([organizationId])
  @@map("tender_clarifications")
}

/// A participant's private question to the issuer. Owner: the asking organisation; counterparty: the issuer.
model TenderQuestion {
  id                   String    @id @default(uuid())
  organizationId       String
  issuerOrganizationId String
  tenderId             String
  question             String    @db.NVarChar(Max)
  askedById            String?
  askedAt              DateTime  @default(now())
  /// Answered state is derived: a TenderClarification with sourceQuestionId = this id exists.

  @@index([tenderId])
  @@index([organizationId])
  @@index([issuerOrganizationId])
  @@map("tender_questions")
}

/// A participant's opt-in to a tender. Owner: the participant; counterparty: the issuer.
model TenderParticipation {
  id                   String   @id @default(uuid())
  organizationId       String
  issuerOrganizationId String
  tenderId             String
  status               String   @default("INTERESTED")
  optedInAt            DateTime @default(now())
  optedInById          String?
  withdrawnAt          DateTime?
  updatedAt            DateTime @updatedAt
  /// Declarations made at opt-in (2026-10-19). exclusionGroundsJson is the declared grounds; exclusionNoGrounds true means "none apply".
  integrityPledgeAt    DateTime?
  exclusionDeclaredAt  DateTime?
  exclusionNoGrounds   Boolean?
  exclusionGroundsJson String?  @db.NVarChar(Max)
  exclusionExplanation String?  @db.NVarChar(Max)

  @@unique([tenderId, organizationId])
  @@index([issuerOrganizationId, tenderId])
  @@map("tender_participations")
}

/// The recorded eligibility result for an organisation against a tender (why it was or was not eligible at the time).
model TenderEligibilityCheck {
  id                   String   @id @default(uuid())
  organizationId       String
  issuerOrganizationId String
  tenderId             String
  outcome              String
  /// JSON array of {ruleId, ruleType, status: MET|NOT_MET|NEEDS_EVIDENCE, action}.
  detailsJson          String   @db.NVarChar(Max)
  checkedAt            DateTime @default(now())

  @@index([tenderId, organizationId, checkedAt])
  @@index([issuerOrganizationId])
  @@map("tender_eligibility_checks")
}

/// A participant's shortlist of tenders (private to the organisation).
model TenderShortlist {
  id             String   @id @default(uuid())
  organizationId String
  tenderId       String
  note           String?  @db.NVarChar(500)
  addedById      String?
  addedAt        DateTime @default(now())

  @@unique([organizationId, tenderId])
  @@map("tender_shortlists")
}

/// A participant's saved criteria, used for a standing "tenders that match you" view and alerts.
model TenderSavedSearch {
  id             String   @id @default(uuid())
  organizationId String
  name           String   @db.NVarChar(200)
  /// JSON: {categories[], countries[], types[], onlyEligible, keyword}.
  criteriaJson   String   @db.NVarChar(Max)
  alertsEnabled  Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@map("tender_saved_searches")
}

/// The shared, append-only audit timeline of a tender (and later the whole engagement). Either party can append; rows are
/// never updated or deleted. Owner: the issuer. Counterparty: the other party the event concerns, if any.
model TenderEvent {
  id                       String   @id @default(uuid())
  organizationId           String
  counterpartyOrganizationId String?
  tenderId                 String
  /// The organisation that did it.
  actorOrganizationId      String
  actorUserId              String?
  kind                     String
  summary                  String   @db.NVarChar(500)
  detailsJson              String?  @db.NVarChar(Max)
  createdAt                DateTime @default(now())
  /// Tamper-evidence (2026-10-19): hash = SHA-256 over prevHash + the event's content; each event links to the previous one for the tender.
  prevHash                 String?  @db.Char(64)
  hash                     String?  @db.Char(64)

  @@index([tenderId, createdAt])
  @@index([organizationId])
  @@index([counterpartyOrganizationId])
  @@map("tender_events")
}

/// A formal change notice to a published tender. Readable by anyone who can see the tender; optionally needs each participant's acknowledgement.
model TenderAddendum {
  id                      String   @id @default(uuid())
  organizationId          String
  tenderId                String
  tender                  Tender   @relation(fields: [tenderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  number                  Int
  title                   String   @db.NVarChar(300)
  body                    String   @db.NVarChar(Max)
  requiresAcknowledgement Boolean  @default(true)
  newClosingAt            DateTime?
  createdById             String?
  createdAt               DateTime @default(now())

  @@unique([tenderId, number])
  @@index([organizationId])
  @@map("tender_addenda")
}

/// A participant's acknowledgement of an addendum. Owned by the participant, readable by the issuer.
model TenderAddendumAck {
  id                   String   @id @default(uuid())
  organizationId       String
  issuerOrganizationId String
  tenderId             String
  addendumId           String
  acknowledgedById     String?
  acknowledgedAt       DateTime @default(now())

  @@unique([addendumId, organizationId])
  @@index([issuerOrganizationId, tenderId])
  @@map("tender_addendum_acks")
}

/// The issuer's record that it screened a participant against sanctions/debarment lists. Private to the issuer; this is an audit entry, Universe does not run the check.
model TenderScreening {
  id                    String   @id @default(uuid())
  organizationId        String
  tenderId              String
  screenedOrganisationId String
  listsJson             String   @db.NVarChar(Max)
  outcome               String
  notes                 String?  @db.NVarChar(Max)
  screenedOn            DateTime
  recordedById          String?
  recordedAt            DateTime @default(now())

  @@index([tenderId])
  @@index([organizationId])
  @@map("tender_screenings")
}

/// A participant's bid on a tender (step 3, 2026-10-19). Owned by the bidding organisation; the issuer reads it as the counterparty,
/// and the service keeps it sealed until the tender's closing time. One bid per organisation per tender.
model TenderBid {
  id                    String    @id @default(uuid())
  organizationId        String
  issuerOrganizationId  String
  tenderId              String
  status                String    @default("DRAFT")
  bidCurrency           String?   @db.Char(3)
  validityConfirmed     Boolean   @default(false)
  validityDays          Int?
  notes                 String?   @db.NVarChar(Max)
  /// Set at submission: the rate used to express the bid in the tender's currency, and the date of that rate (the ECB daily reference rate in force that day).
  fxRate                Decimal?  @db.Decimal(18, 8)
  fxRateDate            DateTime?
  totalBidCurrency      Decimal?  @db.Decimal(18, 2)
  totalTenderCurrency   Decimal?  @db.Decimal(18, 2)
  submittedAt           DateTime?
  withdrawnAt           DateTime?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([tenderId, organizationId])
  @@index([issuerOrganizationId, tenderId])
  @@map("tender_bids")
}

model TenderBidLine {
  id                    String   @id @default(uuid())
  organizationId        String
  issuerOrganizationId  String
  bidId                 String
  tenderId              String
  tenderLineId          String
  noBid                 Boolean  @default(false)
  unitPrice             Decimal? @db.Decimal(18, 4)
  leadTimeDays          Int?
  countryOfOrigin       String?  @db.Char(2)
  manufacturerName      String?  @db.NVarChar(300)
  remarks               String?  @db.NVarChar(1000)

  @@unique([bidId, tenderLineId])
  @@index([issuerOrganizationId, tenderId])
  @@map("tender_bid_lines")
}

model TenderBidResponse {
  id                    String   @id @default(uuid())
  organizationId        String
  issuerOrganizationId  String
  bidId                 String
  tenderId              String
  criterionId           String
  text                  String?  @db.NVarChar(Max)

  @@unique([bidId, criterionId])
  @@index([issuerOrganizationId, tenderId])
  @@map("tender_bid_responses")
}

model TenderBidFile {
  id                    String   @id @default(uuid())
  organizationId        String
  issuerOrganizationId  String
  bidId                 String
  tenderId              String
  criterionId           String?
  fileName              String   @db.NVarChar(300)
  blobName              String   @db.NVarChar(500)
  mimeType              String?
  fileSizeBytes         Int?
  uploadedById          String?
  uploadedAt            DateTime @default(now())

  @@index([bidId])
  @@index([issuerOrganizationId, tenderId])
  @@map("tender_bid_files")
}

// ---------------------------------------------------------------------------
// Tender evaluation, award, debrief and complaints (step 4, 2026-10-20)
// ---------------------------------------------------------------------------

/// A person assigned to evaluate a tender, with their conflict-of-interest declaration. Private to the issuer.
model TenderEvaluator {
  id                String    @id @default(uuid())
  organizationId    String
  tenderId          String
  userId            String
  role              String    @default("EVALUATOR")
  coiDeclaredAt     DateTime?
  coiNoConflict     Boolean?
  /// Comma-separated organisation ids the evaluator declares a conflict with; those bids are hidden from them.
  coiBidderIds      String?   @db.NVarChar(Max)
  coiNotes          String?   @db.NVarChar(Max)
  createdAt         DateTime  @default(now())

  @@unique([tenderId, userId])
  @@index([organizationId])
  @@map("tender_evaluators")
}

/// Pass or fail on a gate criterion for one bid.
model TenderBidGate {
  id             String   @id @default(uuid())
  organizationId String
  tenderId       String
  bidId          String
  criterionId    String
  passed         Boolean
  notes          String?  @db.NVarChar(Max)
  recordedById   String?
  recordedAt     DateTime @default(now())

  @@unique([bidId, criterionId])
  @@index([tenderId])
  @@map("tender_bid_gates")
}

/// One evaluator's score for one bid on one manual criterion. Locked once submittedAt is set.
model TenderBidScore {
  id              String    @id @default(uuid())
  organizationId  String
  tenderId        String
  bidId           String
  criterionId     String
  evaluatorUserId String
  score           Decimal   @db.Decimal(5, 2)
  rationale       String?   @db.NVarChar(Max)
  submittedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([bidId, criterionId, evaluatorUserId])
  @@index([tenderId])
  @@map("tender_bid_scores")
}

/// The agreed score after moderation (or the calculated score for price and lead time).
model TenderModeratedScore {
  id             String   @id @default(uuid())
  organizationId String
  tenderId       String
  bidId          String
  criterionId    String
  score          Decimal  @db.Decimal(5, 2)
  rationale      String?  @db.NVarChar(Max)
  isCalculated   Boolean  @default(false)
  recordedById   String?
  recordedAt     DateTime @default(now())

  @@unique([bidId, criterionId])
  @@index([tenderId])
  @@map("tender_moderated_scores")
}

/// An award to one bidder. A tender may have several (for example a framework with more than one supplier); each covers some lines.
model TenderAward {
  id                    String   @id @default(uuid())
  organizationId        String
  tenderId              String
  bidId                 String
  awardedOrganizationId String
  reason                String   @db.NVarChar(Max)
  awardedAt             DateTime @default(now())
  awardedById           String?

  @@unique([tenderId, bidId])
  @@index([tenderId])
  @@index([awardedOrganizationId])
  @@map("tender_awards")
}

model TenderAwardLine {
  id                    String  @id @default(uuid())
  organizationId        String
  awardedOrganizationId String
  tenderId              String
  awardId               String
  tenderLineId          String
  /// Share of the line's quantity given to this supplier (100 when a single supplier takes the whole line).
  sharePercent          Decimal @db.Decimal(5, 2)

  @@unique([awardId, tenderLineId])
  @@index([tenderId])
  @@map("tender_award_lines")
}

/// The outcome and feedback released to each bidder at award. The scores are a snapshot so bidders never read evaluator tables.
model TenderDebrief {
  id                   String   @id @default(uuid())
  organizationId       String
  tenderId             String
  bidId                String
  bidderOrganizationId String
  outcome              String
  totalScore           Decimal? @db.Decimal(6, 2)
  rank                 Int?
  bidCount             Int?
  scoresJson           String   @db.NVarChar(Max)
  lotsJson             String?  @db.NVarChar(Max)
  feedback             String?  @db.NVarChar(Max)
  releasedAt           DateTime @default(now())

  @@unique([tenderId, bidId])
  @@index([bidderOrganizationId])
  @@map("tender_debriefs")
}

/// A bidder's complaint or request for review during the standstill. Owned by the bidder; the issuer reads and responds.
model TenderComplaint {
  id                   String    @id @default(uuid())
  organizationId       String
  issuerOrganizationId String
  tenderId             String
  body                 String    @db.NVarChar(Max)
  status               String    @default("OPEN")
  response             String?   @db.NVarChar(Max)
  lodgedById           String?
  lodgedAt             DateTime  @default(now())
  respondedAt          DateTime?

  @@index([tenderId])
  @@index([issuerOrganizationId])
  @@map("tender_complaints")
}


// ---------------------------------------------------------------------------
// Quality complaints (2026-10-20). One workflow for two directions: a client or other stakeholder complains to this
// organisation (INBOUND_CLIENT), or this organisation complains about someone in its supply chain (OUTBOUND_SUPPLY_CHAIN).
// Links use the platform's own records (partner, contact, project, line, batch, product) so nothing is re-keyed; every field
// change goes to FieldChangeLog; actions use the shared notification/action mechanism; risks use RiskAssessment with
// subjectType "COMPLAINT". Personal data of the complainant is kept in the few complainant* columns and the contact link
// only, so it can be removed or masked in any anonymised or aggregate use without touching the structured quality data.
// ---------------------------------------------------------------------------
model QualityComplaint {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// CMP-YYYY-NNNN, per organisation per year.
  referenceNumber       String
  /// INBOUND_CLIENT | OUTBOUND_SUPPLY_CHAIN
  direction             String
  /// LOGGED | ACKNOWLEDGED | TRIAGED | INVESTIGATING | RESOLVED | CLOSED | ON_HOLD | WITHDRAWN
  status                String       @default("LOGGED")
  /// Where an ON_HOLD complaint returns to.
  heldFromStatus        String?
  holdReason            String?      @db.NVarChar(1000)
  title                 String       @db.NVarChar(300)
  description           String       @db.NVarChar(Max)
  receivedAt            DateTime
  /// EMAIL | PHONE | MEETING | PORTAL | LETTER | OTHER
  channel               String?
  /// CRITICAL | MAJOR | MINOR (set at triage; CRITICAL is forced by the serious flags).
  severity              String?
  /// PRODUCT_QUALITY | DELIVERY | DOCUMENTATION | COLD_CHAIN | SERVICE | SAFETY | CONDUCT | OTHER
  category              String?
  isSerious             Boolean      @default(false)
  flagPatientSafety     Boolean      @default(false)
  flagSuspectedFalsified Boolean     @default(false)
  flagTemperatureExcursion Boolean   @default(false)

  /// The other party: the client/funder/partner for INBOUND_CLIENT, the manufacturer/supplier/forwarder for OUTBOUND_SUPPLY_CHAIN.
  partnerId             String?
  partner               Partner?     @relation("ComplaintPartner", fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contactId             String?
  contact               Contact?     @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Personal data (kept apart so it can be masked): used when the person is not a stored contact.
  complainantName       String?      @db.NVarChar(300)
  complainantEmail      String?      @db.NVarChar(300)
  complainantPhone      String?      @db.NVarChar(100)
  projectId             String?
  project               Project?     @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectLineId         String?
  projectLine           ProjectLine? @relation(fields: [projectLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productBatchId        String?
  productBatch          ProductBatch? @relation(fields: [productBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productMasterId       String?
  productMaster         ProductMaster? @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  ownerId               String?
  investigatorId        String?
  loggedById            String?

  acknowledgeDueAt      DateTime?
  acknowledgedAt        DateTime?
  triageDueAt           DateTime?
  triagedAt             DateTime?
  resolveDueAt          DateTime?
  investigationStartedAt DateTime?
  investigationCompletedAt DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?

  investigationScope    String?      @db.NVarChar(Max)
  /// MATERIAL | MANUFACTURING | DOCUMENTATION | TRANSPORT_COLD_CHAIN | HANDLING_STORAGE | PROCESS | HUMAN_ERROR | SUPPLIER | NOT_DETERMINED | OTHER
  rootCauseCategory     String?
  rootCause             String?      @db.NVarChar(Max)
  findings              String?      @db.NVarChar(Max)
  impactSummary         String?      @db.NVarChar(Max)
  /// UPHELD | PARTLY_UPHELD | NOT_UPHELD
  outcome               String?

  /// Outbound: the partner's side of it.
  partnerResponseDueAt  DateTime?
  partnerRespondedAt    DateTime?
  partnerResponse       String?      @db.NVarChar(Max)

  /// REPLACEMENT | CREDIT | REDELIVERY | CORRECTED_DOCUMENTS | EXPLANATION | NO_REMEDY | OTHER
  remedyType            String?
  remedyNotes           String?      @db.NVarChar(Max)
  responseSentAt        DateTime?
  responseSummary       String?      @db.NVarChar(Max)
  /// SATISFIED | NOT_SATISFIED | NO_RESPONSE
  complainantReaction   String?

  /// Regulator reporting is a person's decision; Universe records it. UNDER_CONSIDERATION | REPORTED | NOT_REPORTABLE
  regulatorDecision     String?
  regulatorDecisionReason String?    @db.NVarChar(1000)
  regulatorReference    String?      @db.NVarChar(200)
  regulatorDecisionById String?
  regulatorDecisionAt   DateTime?

  closureSummary        String?      @db.NVarChar(Max)
  lessonsLearned        String?      @db.NVarChar(Max)
  effectivenessCheckDueAt DateTime?
  effectivenessCheckedAt DateTime?
  effectivenessNotes    String?      @db.NVarChar(Max)
  closedById            String?
  /// Four-eyes: the investigator may close only with a recorded reason.
  closureOverrideReason String?      @db.NVarChar(1000)
  reopenCount           Int          @default(0)

  archivedAt            DateTime?
  archivedById          String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  events                QualityComplaintEvent[]
  actions               QualityComplaintAction[]
  attachments           QualityComplaintDocument[]

  @@unique([organizationId, referenceNumber])
  @@index([organizationId, status])
  @@index([organizationId, direction, status])
  @@index([partnerId])
  @@index([projectId])
  @@index([productBatchId])
  @@index([productMasterId])
  @@map("quality_complaints")
}

/// The complaint's timeline: stage changes, notes and communications with the complainant or partner. Append-only.
model QualityComplaintEvent {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  complaintId    String
  complaint      QualityComplaint @relation(fields: [complaintId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// STAGE | NOTE | COMMUNICATION_OUT | COMMUNICATION_IN | REGULATOR | LINK
  kind           String
  summary        String           @db.NVarChar(500)
  body           String?          @db.NVarChar(Max)
  actorUserId    String?
  createdAt      DateTime         @default(now())

  @@index([complaintId, createdAt])
  @@index([organizationId])
  @@map("quality_complaint_events")
}

/// Evidence files attached to a complaint (photos, correspondence, test reports). Added 2026-10-24.
/// Links a complaint to a standalone ProjectDocument; archive-not-delete.
model QualityComplaintDocument {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  complaintId    String
  complaint      QualityComplaint @relation(fields: [complaintId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documentId     String
  document       ProjectDocument  @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Free-text note on what the file shows.
  note           String?          @db.NVarChar(500)
  createdById    String?
  createdAt      DateTime         @default(now())
  archivedAt     DateTime?
  archivedById   String?

  @@index([complaintId])
  @@index([organizationId])
  @@index([documentId])
  @@map("quality_complaint_documents")
}

/// Corrective, preventive and containment actions raised by a complaint. Each open action is also an action item for its owner.
model QualityComplaintAction {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  complaintId    String
  complaint      QualityComplaint @relation(fields: [complaintId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// CONTAINMENT | CORRECTIVE | PREVENTIVE
  type           String
  description    String           @db.NVarChar(Max)
  ownerId        String
  dueDate        DateTime
  /// OPEN | DONE | CANCELLED
  status         String           @default("OPEN")
  completedAt    DateTime?
  completionNotes String?         @db.NVarChar(Max)
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([complaintId])
  @@index([organizationId, status, dueDate])
  @@map("quality_complaint_actions")
}


/// Per-organisation delivery-scoring parameters for the partner scorecard (2026-10-20). One row per organisation; absent = platform
/// defaults (see SCORECARD_THRESHOLDS in packages/types: USAID GHSC-PSM and Global Fund practice). Changes go to FieldChangeLog.
model QualityScorecardSettings {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  onTimeGood     Int          @default(95)
  onTimeWarn     Int          @default(85)
  inFullGood     Int          @default(95)
  inFullWarn     Int          @default(85)
  otifGood       Int          @default(90)
  otifWarn       Int          @default(80)
  /// Working days early / late within which a delivery still counts as on time.
  earlyDays      Int          @default(30)
  lateDays       Int          @default(5)
  updatedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("quality_scorecard_settings")
}

/// Lets a user whose home organisation is a demo organisation switch into other demo organisations (2026-10-20), keeping their own
/// permissions. Identity-level, so deliberately has no organizationId and no row-level security; created by scripts or platform staff
/// only. The guard re-checks on every request that both organisations are demo ones, so a grant can never reach a real organisation.
model UserOrganizationAccess {
  id                    String       @id @default(uuid())
  userId                String
  user                  User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  grantedOrganizationId String
  grantedOrganization   Organization @relation(fields: [grantedOrganizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Who put the grant in place (an operator's email or a script name), for audit.
  grantedBy             String?
  createdAt             DateTime     @default(now())

  @@unique([userId, grantedOrganizationId])
  @@index([grantedOrganizationId])
  @@map("user_organization_access")
}


// ---------------------------------------------------------------------------
// Tender contracts (step 5, 2026-10-21): one contract per award, shared by the issuer and the awarded supplier.
// organizationId is the issuer, awardedOrganizationId the supplier; either may write (service enforces who may do what).
// ---------------------------------------------------------------------------

model TenderContract {
  id                    String    @id @default(uuid())
  organizationId        String
  awardedOrganizationId String
  tenderId              String
  awardId               String    @unique
  reference             String    @db.NVarChar(100)
  title                 String    @db.NVarChar(300)
  /// DRAFT, AWAITING_SIGNATURE, ACTIVE, COMPLETED, TERMINATED
  status                String    @default("DRAFT")
  currency              String?   @db.Char(3)
  totalValue            Decimal?  @db.Decimal(18, 2)
  startDate             DateTime?
  endDate               DateTime?
  terms                 String?   @db.NVarChar(Max)
  sentAt                DateTime?
  executedAt            DateTime?
  closedAt              DateTime?
  closeNote             String?   @db.NVarChar(2000)
  /// The supplier's Project Management project created from this contract (handover).
  supplierProjectId     String?
  createdById           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([tenderId])
  @@index([awardedOrganizationId])
  @@index([organizationId])
  @@map("tender_contracts")
}

model TenderContractMilestone {
  id                    String    @id @default(uuid())
  organizationId        String
  awardedOrganizationId String
  tenderId              String
  contractId            String
  title                 String    @db.NVarChar(300)
  dueDate               DateTime?
  /// PENDING, DONE, MISSED
  status                String    @default("PENDING")
  completedAt           DateTime?
  notes                 String?   @db.NVarChar(1000)
  sortOrder             Int       @default(0)

  @@index([contractId])
  @@map("tender_contract_milestones")
}

/// Signature section: the externally executed agreement, its certificate or audit trail, variations; each file kept with its version.
model TenderContractFile {
  id                     String   @id @default(uuid())
  organizationId         String
  awardedOrganizationId  String
  tenderId               String
  contractId             String
  /// DRAFT, SIGNED, CERTIFICATE, VARIATION, OTHER
  kind                   String
  version                Int      @default(1)
  title                  String   @db.NVarChar(300)
  fileName               String   @db.NVarChar(300)
  blobName               String   @db.NVarChar(500)
  mimeType               String?
  fileSizeBytes          Int?
  /// The file sits in this organisation's own storage container.
  uploadedByOrganizationId String
  uploadedById           String?
  uploadedAt             DateTime @default(now())
  note                   String?  @db.NVarChar(1000)

  @@index([contractId])
  @@map("tender_contract_files")
}

model TenderContractSignatory {
  id                     String   @id @default(uuid())
  organizationId         String
  awardedOrganizationId  String
  tenderId               String
  contractId             String
  /// ISSUER or SUPPLIER
  party                  String
  signerName             String   @db.NVarChar(200)
  signerRole             String?  @db.NVarChar(200)
  signedOn               DateTime
  recordedByOrganizationId String
  recordedById           String?
  recordedAt             DateTime @default(now())

  @@index([contractId])
  @@map("tender_contract_signatories")
}

/// Step 6 (2026-10-21): the frozen performance record for one closed contract. Shared by the issuer and the awarded supplier (two-party RLS).
/// Measures are a snapshot taken at close; the flat columns exist so the anonymised supplier aggregate can be computed without parsing JSON.
model TenderPerformanceRecord {
  id                    String    @id @default(uuid())
  organizationId        String
  awardedOrganizationId String
  tenderId              String
  contractId            String    @unique
  /// COMPLETED or TERMINATED
  outcome               String    @db.NVarChar(20)
  closedAt              DateTime
  /// JSON array of ScorecardMetric-shaped measures (key, label, display, score, status, weight, detail, coverage).
  measuresJson          String    @db.NVarChar(Max)
  overallScore          Int?
  /// STRONG, SATISFACTORY, WATCH, AT_RISK, NOT_ENOUGH_DATA
  band                  String    @db.NVarChar(30)
  coverage              Int       @default(0)
  milestonesTotal       Int       @default(0)
  milestonesOnTime      Int       @default(0)
  /// Null when the delivery project was not created or has no marked deliveries.
  onTimePercent         Int?
  inFullPercent         Int?
  otifPercent           Int?
  /// Owner feedback, 1 to 5 each; JSON object of {quality, communication, documentation, flexibility, wouldUseAgain} plus reasons, and a comment.
  feedbackJson          String?   @db.NVarChar(Max)
  feedbackAverage       Decimal?  @db.Decimal(4, 2)
  /// The supplier may reply or dispute until this date; feedback is locked once a reply exists.
  replyDeadline         DateTime
  /// Set by platform staff only, for evident error or abuse.
  withdrawnAt           DateTime?
  withdrawnReason       String?   @db.NVarChar(1000)
  createdById           String?
  createdAt             DateTime  @default(now())

  @@index([tenderId])
  @@index([awardedOrganizationId])
  @@index([organizationId])
  @@map("tender_performance_records")
}

/// Supplier reply or dispute on a record, and the owner's answer to a dispute.
model TenderPerformanceResponse {
  id                    String   @id @default(uuid())
  organizationId        String
  awardedOrganizationId String
  tenderId              String
  recordId              String
  /// REPLY, DISPUTE (supplier); ANSWER (owner)
  kind                  String   @db.NVarChar(20)
  /// For a dispute, the measure disputed (for example "milestones").
  measureKey            String?  @db.NVarChar(50)
  body                  String   @db.NVarChar(2000)
  byOrganizationId      String
  byUserId              String?
  createdAt             DateTime @default(now())

  @@index([recordId])
  @@map("tender_performance_responses")
}

/// Manual payment log on a contract. Organisations run their own finance systems, so either party records invoices and when they were paid;
/// nothing is read from, or written to, a finance system. Used for the anonymised owner payment-practice aggregate.
model TenderContractPayment {
  id                    String    @id @default(uuid())
  organizationId        String
  awardedOrganizationId String
  tenderId              String
  contractId            String
  reference             String    @db.NVarChar(100)
  description           String?   @db.NVarChar(300)
  amount                Decimal   @db.Decimal(18, 2)
  currency              String?   @db.Char(3)
  invoiceDate           DateTime?
  dueDate               DateTime
  paidDate              DateTime?
  recordedByOrganizationId String
  recordedById          String?
  recordedAt            DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([contractId])
  @@index([organizationId])
  @@map("tender_contract_payments")
}

/// Step 6 follow-up (2026-10-21): the tender owner's own quality complaints and temperature logs that it ties to a contract, so the
/// performance record can measure quality and cold chain. Private to the owner (the supplier only ever sees counts in the frozen measures).
model TenderContractQualityLink {
  id             String   @id @default(uuid())
  organizationId String
  contractId     String
  /// COMPLAINT or TEMPERATURE_LOG
  kind           String   @db.NVarChar(20)
  refId          String
  createdById    String?
  createdAt      DateTime @default(now())

  @@unique([contractId, kind, refId])
  @@index([contractId])
  @@map("tender_contract_quality_links")
}

/// Organisation-level call-off approval limits (step 7 part 2). Private to the organisation. `confirmedAt` is null while the defaults are untouched.
model TenderApprovalSettings {
  id              String    @id @default(uuid())
  organizationId  String    @unique
  /// A call-off up to this value (including recent call-offs to the same supplier) needs one authoriser, who may be the person raising it; above it a second, different authoriser is needed.
  individualLimit Decimal   @default(25000) @db.Decimal(18, 2)
  /// Call-offs to the same supplier raised within this many days count together, so a large order cannot be split to stay under the limit.
  splitWindowDays Int       @default(30)
  /// Currency the limits are written in (3-letter code). Null = the limit is read in each tender's own currency, as before 2026-10-24.
  limitCurrency   String?   @db.Char(3)
  confirmedAt     DateTime?
  updatedById     String?
  updatedAt       DateTime  @default(now()) @updatedAt

  @@map("tender_approval_settings")
}

/// A limit for people holding a role (2026-10-24). Someone who holds one or more limited roles may authorise alone up to the highest of them; everyone else uses the organisation's default limit.
model TenderApprovalRoleLimit {
  id             String   @id @default(uuid())
  organizationId String
  roleId         String
  limit          Decimal  @db.Decimal(18, 2)
  updatedById    String?
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([organizationId, roleId])
  @@map("tender_approval_role_limits")
}

/// An order placed against a framework agreement with one supplier. Shared by the owner and the supplier.
model TenderCallOff {
  id                    String    @id @default(uuid())
  organizationId        String
  awardedOrganizationId String
  tenderId              String
  contractId            String
  reference             String    @db.NVarChar(100)
  /// DIRECT or ROTATION
  method                String    @db.NVarChar(20)
  /// PENDING_APPROVAL, AWAITING_SUPPLIER, ACCEPTED, DECLINED, CANCELLED
  status                String    @default("PENDING_APPROVAL")
  currency              String?   @db.Char(3)
  totalValue            Decimal   @db.Decimal(18, 2)
  /// Value tested against the approval limit: this order plus recent orders to the same supplier.
  testedValue           Decimal   @db.Decimal(18, 2)
  requiresSecondApproval Boolean  @default(false)
  ceilingExceeded       Boolean   @default(false)
  deliveryCountryCode   String?   @db.Char(2)
  requiredBy            DateTime?
  notes                 String?   @db.NVarChar(1000)
  raisedById            String
  firstApprovedById     String?
  firstApprovedAt       DateTime?
  secondApprovedById    String?
  secondApprovedAt      DateTime?
  rejectedReason        String?   @db.NVarChar(1000)
  respondedAt           DateTime?
  declineReason         String?   @db.NVarChar(1000)
  supplierProjectId     String?
  /// The winning quote when this call-off came from a mini-competition.
  quoteId               String?
  createdAt             DateTime  @default(now())

  @@index([tenderId])
  @@index([contractId])
  @@index([awardedOrganizationId])
  @@map("tender_call_offs")
}

model TenderCallOffLine {
  id                    String   @id @default(uuid())
  organizationId        String
  awardedOrganizationId String
  tenderId              String
  callOffId             String
  tenderLineId          String
  quantity              Decimal  @db.Decimal(18, 3)
  /// Price snapshot at the time of the call-off, in the tender currency.
  unitPrice             Decimal  @db.Decimal(18, 4)
  lineTotal             Decimal  @db.Decimal(18, 2)

  @@index([callOffId])
  @@map("tender_call_off_lines")
}

/// A line-level price review on a framework contract, possible once the price-hold period has ended. The other party accepts or rejects.
model TenderPriceReview {
  id                    String    @id @default(uuid())
  organizationId        String
  awardedOrganizationId String
  tenderId              String
  contractId            String
  tenderLineId          String
  previousPrice         Decimal   @db.Decimal(18, 4)
  proposedPrice         Decimal   @db.Decimal(18, 4)
  reason                String    @db.NVarChar(1000)
  proposedByOrganizationId String
  /// PROPOSED, ACCEPTED, REJECTED
  status                String    @default("PROPOSED")
  respondedAt           DateTime?
  responseNote          String?   @db.NVarChar(1000)
  createdAt             DateTime  @default(now())

  @@index([contractId])
  @@map("tender_price_reviews")
}

/// A mini-competition among framework suppliers for one call-off (step 7 part 2b). Private to the owner; each invited supplier sees only its own quote row.
model TenderMiniCompetition {
  id                  String    @id @default(uuid())
  organizationId      String
  tenderId            String
  reference           String    @db.NVarChar(100)
  /// OPEN, AWARDED, CANCELLED
  status              String    @default("OPEN")
  notes               String?   @db.NVarChar(1000)
  deliveryCountryCode String?   @db.Char(2)
  requiredBy          DateTime?
  closesAt            DateTime
  /// [{ tenderLineId, quantity }]
  linesJson           String    @db.NVarChar(Max)
  awardedQuoteId      String?
  awardReason         String?   @db.NVarChar(1000)
  cancelReason        String?   @db.NVarChar(1000)
  createdById         String
  createdAt           DateTime  @default(now())

  @@index([tenderId])
  @@map("tender_mini_competitions")
}

/// One invited supplier's invitation and quote. Shared by the owner and that supplier only, so suppliers never see each other.
model TenderCallOffQuote {
  id                    String    @id @default(uuid())
  organizationId        String
  awardedOrganizationId String
  tenderId              String
  competitionId         String
  contractId            String
  reference             String    @db.NVarChar(100)
  /// INVITED, QUOTED, DECLINED, WON, LOST, CANCELLED
  status                String    @default("INVITED")
  closesAt              DateTime
  requestNotes          String?   @db.NVarChar(1000)
  deliveryCountryCode   String?   @db.Char(2)
  requiredBy            DateTime?
  quotedAt              DateTime?
  totalValue            Decimal?  @db.Decimal(18, 2)
  quoteNotes            String?   @db.NVarChar(1000)
  declineReason         String?   @db.NVarChar(1000)
  createdAt             DateTime  @default(now())

  @@index([competitionId])
  @@index([awardedOrganizationId])
  @@map("tender_call_off_quotes")
}

model TenderCallOffQuoteLine {
  id                    String   @id @default(uuid())
  organizationId        String
  awardedOrganizationId String
  tenderId              String
  quoteId               String
  tenderLineId          String
  quantity              Decimal  @db.Decimal(18, 3)
  /// The agreed framework price: a quote may match it or go below, never above.
  frameworkPrice        Decimal  @db.Decimal(18, 4)
  quotedPrice           Decimal? @db.Decimal(18, 4)
  leadTimeDays          Int?

  @@index([quoteId])
  @@map("tender_call_off_quote_lines")
}

/// A formal change to a signed contract (step 7 part 3). Either party proposes; the other must accept before anything changes. Shared by the owner and the supplier only.
model TenderContractVariation {
  id                       String    @id @default(uuid())
  organizationId           String
  awardedOrganizationId    String
  tenderId                 String
  contractId               String
  number                   Int
  title                    String    @db.NVarChar(300)
  reason                   String    @db.NVarChar(1000)
  /// New total value, if the value changes
  newTotalValue            Decimal?  @db.Decimal(18, 2)
  previousTotalValue       Decimal?  @db.Decimal(18, 2)
  newEndDate               DateTime?
  previousEndDate          DateTime?
  /// Wording of an amendment to the terms, appended to the contract terms once accepted
  termsAmendment           String?   @db.NVarChar(Max)
  /// PROPOSED, ACCEPTED, REJECTED, WITHDRAWN
  status                   String    @default("PROPOSED")
  proposedByOrganizationId String
  proposedById             String?
  createdAt                DateTime  @default(now())
  respondedById            String?
  respondedAt              DateTime?
  responseNote             String?   @db.NVarChar(1000)
  appliedAt                DateTime?

  @@index([contractId])
  @@map("tender_contract_variations")
}

/// Evidence logged against a contract (step 7 part 3): a typed, dated record with an optional file and its SHA-256 fingerprint, linked to a milestone, payment, variation or call-off. Append-only: it can be withdrawn with a reason, never edited or deleted. Shared by the owner and the supplier.
model TenderEvidence {
  id                         String    @id @default(uuid())
  organizationId             String
  awardedOrganizationId      String
  tenderId                   String
  contractId                 String
  kind                       String    @db.NVarChar(40)
  title                      String    @db.NVarChar(300)
  description                String?   @db.NVarChar(2000)
  reference                  String?   @db.NVarChar(200)
  evidenceDate               DateTime
  /// MILESTONE, PAYMENT, VARIATION, CALL_OFF, or null for the contract as a whole
  linkType                   String?   @db.NVarChar(20)
  linkId                     String?
  blobName                   String?   @db.NVarChar(500)
  fileName                   String?   @db.NVarChar(300)
  mimeType                   String?   @db.NVarChar(200)
  fileSizeBytes              Int?
  sha256                     String?   @db.NVarChar(64)
  recordedByOrganizationId   String
  recordedById               String?
  recordedAt                 DateTime  @default(now())
  acknowledgedByOrganizationId String?
  acknowledgedById           String?
  acknowledgedAt             DateTime?
  withdrawnAt                DateTime?
  withdrawnReason            String?   @db.NVarChar(1000)

  @@index([contractId])
  @@map("tender_evidence")
}

/// Reference register of authorised medicines (2026-10-23): one row per EMA product number or MHRA authorisation (PL) number, loaded by
/// the weekly pharma-reference sync from the EMA medicines data table and the MHRA Windsor Framework category lists. Global reference
/// data, not tenant data (no organizationId, no RLS), read by every signed-in user. A pointer to the official register, not the
/// authorised product information, which prevails. Rows missing from a later file are marked removedAt, never deleted.
model PharmaReference {
  id                       String    @id @default(uuid())
  /// EMA | MHRA
  source                   String    @db.NVarChar(20)
  /// EMA product number (EMEA/H/C/000917) or MHRA authorisation number (PL 00010/0756).
  sourceKey                String    @db.NVarChar(100)
  name                     String    @db.NVarChar(500)
  activeSubstances         String?   @db.NVarChar(Max)
  inn                      String?   @db.NVarChar(500)
  /// ATC code (human) or ATCvet code. EMA only.
  atcCode                  String?   @db.NVarChar(20)
  holder                   String?   @db.NVarChar(500)
  /// MHRA legal status: POM | P | GSL.
  legalStatus              String?   @db.NVarChar(20)
  /// MHRA Windsor Framework list: Category 1 | Category 2.
  windsorCategory          String?   @db.NVarChar(20)
  /// HUMAN | VETERINARY
  productType              String    @db.NVarChar(20)
  /// EMA: Authorised, Withdrawn, Refused, Lapsed, Opinion, Application withdrawn. MHRA: Authorised.
  status                   String    @db.NVarChar(50)
  isGeneric                Boolean   @default(false)
  isBiosimilar             Boolean   @default(false)
  isOrphan                 Boolean   @default(false)
  therapeuticArea          String?   @db.NVarChar(1000)
  pharmacotherapeuticGroup String?   @db.NVarChar(500)
  indication               String?   @db.NVarChar(Max)
  authorisedOn             DateTime?
  sourceUrl                String?   @db.NVarChar(1000)
  rawHash                  String    @db.NVarChar(64)
  firstSeenAt              DateTime  @default(now())
  lastSeenAt               DateTime  @default(now())
  removedAt                DateTime?

  links                    ProductPharmaLink[]

  @@unique([source, sourceKey])
  @@index([atcCode])
  @@index([status])
  @@map("pharma_references")
}

/// One row per sync of a register (evidence that the reference data is kept current).
model PharmaReferenceRun {
  id         String    @id @default(uuid())
  source     String    @db.NVarChar(20)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("RUNNING") @db.NVarChar(20)
  fetched    Int       @default(0)
  added      Int       @default(0)
  changed    Int       @default(0)
  removed    Int       @default(0)
  error      String?   @db.NVarChar(Max)

  @@map("pharma_reference_runs")
}

/// Link between a catalogue product and an entry in the EMA/MHRA register. Global (like product_master), no tenant column.
/// SUGGESTED by the matcher, then CONFIRMED or REJECTED by a person; only CONFIRMED links drive leaflet links and the verified badge.
model ProductPharmaLink {
  id                String           @id @default(uuid())
  productMasterId   String
  product           ProductMaster    @relation(fields: [productMasterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pharmaReferenceId String
  reference         PharmaReference  @relation(fields: [pharmaReferenceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /// SUGGESTED | CONFIRMED | REJECTED
  status            String           @default("SUGGESTED") @db.NVarChar(20)
  /// 0-100 match score and the fields that matched, e.g. "brand, inn".
  score             Int              @default(0)
  basis             String?          @db.NVarChar(200)
  decidedById       String?          @db.NVarChar(100)
  decidedByName     String?          @db.NVarChar(200)
  decidedAt         DateTime?
  /// Ringfence: true when the product is simulated demo data. Such links are visible only inside demo organisations and never counted for real ones.
  isSimulated       Boolean          @default(false)
  createdAt         DateTime         @default(now())

  @@unique([productMasterId, pharmaReferenceId])
  @@index([pharmaReferenceId])
  @@index([status])
  @@index([isSimulated])
  @@map("product_pharma_links")
}

/// Per-person Insights personalisation (2026-10-25): saved views (a page plus its filters) and the highlights a person pins to their Overview.
/// Owned by the person (userId) inside their organisation (row-level security by organizationId). Archive-not-delete: removing a view sets archivedAt.
model InsightsUserItem {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId         String
  /// VIEW (saved view) or PIN (a highlight shown on the Overview).
  kind           String       @db.NVarChar(10)
  name           String       @db.NVarChar(120)
  /// VIEW: the route, e.g. /services. PIN: the highlight id, e.g. commodities.biggest.
  target         String       @db.NVarChar(120)
  stateJson      String?      @db.NVarChar(4000)
  position       Int          @default(0)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, userId, kind])
  @@map("insights_user_items")
}
