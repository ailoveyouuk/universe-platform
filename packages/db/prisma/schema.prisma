// Universe Platform — Shared Database Schema
// Single source of truth for every app (Project Management, CRM, Product
// Database, Tender, Admin) AND every tenant organization using the platform.
// Provider: Azure SQL Database.
//
// MULTI-TENANCY MODEL (added 2026-09-08):
// Universe is a standalone multi-tenant platform, not affiliated with or
// owned by any one customer organization. Every organization that uses it —
// including whichever organization pilots it first — onboards as a fully
// isolated tenant with no special standing over any other. Every domain
// table carries an `organizationId`
// directly (denormalized on purpose, not just reachable via a join) so that:
//   1. The API layer can trivially auto-scope every query to the caller's
//      organization (see apps/api/src/common/tenant-scoped.ts).
//   2. Azure SQL Row-Level Security policies can be applied per-table as a
//      second, independent enforcement layer — so a bug in the API layer
//      alone can't leak one organization's data into another's queries.
// Identity: Microsoft Entra External ID (CIAM), in a dedicated "Universe"
// identity tenant, wholly separate from any customer organization's own
// corporate Entra ID tenant, so no organization's identities mix with
// another's or with Universe's own operating team's directory.
//
// NAMING: "Organization" vs "Partner" (added 2026-09-24 — read this first)
// `Organization` is ALWAYS the tenant root — one row per company using
// Universe as a platform. It is never a client/supplier/manufacturer record.
// A real-world company that a tenant does business with (their client, their
// supplier, their manufacturer, their freight forwarder — any combination of
// these) is a `Partner` instead — a completely different model, scoped to
// the tenant that knows about it via `organizationId`. This mirrors the
// "Organizations + OrganizationRoles" pattern from the 2026-09-24 reference
// architecture review, renamed to `Partner`/`PartnerRole` specifically to
// avoid colliding with the platform's own tenant concept.
//
// HEADER + LINE PROJECTS (added 2026-09-24):
// `Project` is the header (Reference Number, Client, Contact, dates, leads,
// status — facts shared across every item under one engagement). `ProjectLine`
// is one row per item/country/lot, carrying everything that varies per line:
// manufacturer, supplier, pricing, freight, procurement, logistics, and (for
// pharma) batch-level fields. This replaces the earlier 1:1
// ProjectProcurement/ProjectFinancials/ProjectLogistics design, which
// silently assumed one supplier/price/freight arrangement per project — real
// data shows a single Reference Number routinely spans multiple line-level
// facts sharing only the header. See the architecture doc, "Reference
// architecture review (2026-09-24)".
//
// PRODUCT CLASSIFICATION & THE SHARED CATALOG (added 2026-09-24):
// `ProductMaster` is deliberately NOT tenant-scoped — it's shared reference
// data (like the taxonomies below), the same way a dictionary of commodities
// isn't owned by any one user. Individual tenants' own transactional data
// (`ProductLine`, `ProjectLine`) IS tenant-scoped as normal and links to
// `ProductMaster` once a product is identified/matched. This is what makes
// the "type Cryovial, get prompted for size" experience possible, and what
// lets the catalog grow richer as more tenants use the platform — Unimed's
// own already-assigned GS1 GTINs are the first real seed data (owned
// outright, no licensing question), HS codes and the WTO Medical Goods List
// are open and importable now, UNSPSC is free (post-2025 UNDP stewardship)
// pending a signed embedding-terms addendum, and the WHO Essential Medicines
// List (CC BY 3.0 IGO) is safe to use — WHO's Prequalification lists are
// deliberately NOT imported yet pending a written permissions request to
// WHO (see architecture doc, "Sector-insights data strategy").
//
// REFERENTIAL ACTIONS (added 2026-09-10, first real `prisma generate` run):
// Every foreign key below is explicit `onDelete: NoAction, onUpdate: NoAction`.
// This isn't a stylistic choice — Azure SQL Server rejects a schema where a
// table is reachable from another table's cascade delete/update through more
// than one path, and this schema has many such paths. Rather than hand-tune
// which single path is allowed to cascade (fragile — breaks again the next
// time a relation is added), cascading is turned off everywhere and handled
// explicitly in application code instead. That's arguably the right call
// anyway for a multi-tenant platform: deleting an Organization (or a User, or
// a Project) should be a deliberate, audited service-layer operation, never
// an implicit side effect propagating silently through a dozen tables.
//
// ENUMS (added 2026-09-10, first real `prisma generate` run):
// Prisma does not support native enum types on the SQL Server connector at
// all (a hard platform limitation, confirmed by `prisma generate` itself —
// not a version issue). Every field that was modeled as a Prisma `enum` is a
// `String` column instead; the allowed values are documented in comments
// here and enforced at the application layer. The canonical, importable list
// of these values lives in packages/db/src/enums.ts (@universe/db).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Allowed values reference (enforced in application code, not the database)
// Kept as GLOBAL fixed lists, not per-organization — reinforced 2026-09-24 as
// a hard requirement rather than a "for now" default, since the sector-
// insights goal depends on every tenant using the same values for cross-
// organization comparability.
//
// Project.category         — PROCUREMENT | TECHNICAL_ASSISTANCE
// Project.projectType      — PHARMACEUTICAL | NON_PHARMACEUTICAL
// Project.status           — IDENTIFIED | IN_PROGRESS | SUBMITTED | AWARDED |
//                             COMPLETED | UNAWARDED | DECLINED | CANCELLED
// ProjectLine.incoterm     — EXW | FCA | FAS | FOB | CPT | CIP | CFR | CIF |
//                             DAP | DPU | DDP
// ProjectLine.freightMode  — AIR | SEA | LAND
// ProjectLine.productCategory — CONSUMABLES | DEVICES | REAGENTS | EQUIPMENT |
//                             PHARMACEUTICALS | LABORATORY
// ProjectDocument.type     — CHECKLIST | ISSUES | CLOSEOUT_REPORT | OTHER
// Project.completionStage — DELIVERED | FINANCIALLY_CLOSED | CLOSEOUT_FILED
//                             (sub-state within COMPLETED only — added 2026-09-30,
//                             see procurement-lifecycle-benchmarking.md rec. #1)
// ProjectLine.supplierPaymentStatus — NOT_STARTED | PARTIALLY_PAID | PAID | OVERDUE
//                             (replaces supplierPaymentStatusPercent — added
//                             2026-09-30, see benchmarking doc rec. #2)
// ProjectLine.qualificationPathway — WHO_PQ | SRA | ERP | ISO13485 | ISO9001 |
//                             WHOPES | GHTF | OTHER (added 2026-09-30, see
//                             benchmarking doc rec. #4)
// Organization.status      — PILOT | ACTIVE | SUSPENDED
// Organization.type        — PROCUREMENT_SERVICE_AGENT | TENDERING_PURCHASING_BODY |
//                             MANUFACTURER | SUPPLIER | FUNDER_DONOR |
//                             DATA_INSIGHTS_USER (expanded 2026-09-26 from the
//                             original BUYER|SUPPLIER pair — see
//                             claude/stakeholder-taxonomy-research.md and
//                             architecture-decisions.md for the taxonomy this
//                             maps to. PROCUREMENT_SERVICE_AGENT is the
//                             renamed former BUYER (Unimed's own category —
//                             an org that runs projects/tenders on behalf of
//                             a client). TENDERING_PURCHASING_BODY is a
//                             government/FBO/implementing-partner org that
//                             issues and manages its OWN tenders directly —
//                             functionally the same app access as
//                             PROCUREMENT_SERVICE_AGENT (same role template)
//                             but a distinct real-world category worth
//                             tracking. Deliberately NOT given any
//                             cross-org visibility into a procurement
//                             agent's projects (2026-09-26 decision — an
//                             agent's project financials/margins are
//                             commercially unique to the agent, not the
//                             funding body). MANUFACTURER and SUPPLIER are
//                             now two separate types (previously one
//                             SUPPLIER type covered both) — both get a
//                             marketplace-profile role template, just with
//                             their own permission keys. FUNDER_DONOR and
//                             DATA_INSIGHTS_USER are new, minimal,
//                             placeholder categories — see their role
//                             templates in organizations.ts for what's
//                             actually enforced today vs. flagged as future
//                             work.
// Organization.legalEntityType — GOVERNMENT_AGENCY | PRIVATE_COMPANY |
//                             REGISTERED_NGO | FAITH_BASED_NETWORK |
//                             MULTILATERAL_UN_BODY | COOPERATIVE |
//                             ACADEMIC_INSTITUTION | INDIVIDUAL | OTHER
//                             (added 2026-09-26 — see
//                             claude/org-onboarding-data-model.md, universal
//                             fields)
// Organization.onboardingSource — SELF_REFERRED |
//                             INVITED_BY_PROCUREMENT_AGENT |
//                             INVITED_BY_FUNDER | PLATFORM_STAFF_OUTREACH |
//                             OTHER (added 2026-09-26)
// ProcurementAgentProfile.logisticsCapability — OWN | SUBCONTRACTED | MIXED
//                             (added 2026-09-26)
// TenderingBodyProfile.bodyType — GOVERNMENT | FAITH_BASED_NETWORK |
//                             NGO_IMPLEMENTING_PARTNER | MULTILATERAL
//                             (added 2026-09-26)
// SupplierProfile.warehousingCapability — OWN | THIRD_PARTY | MIXED
//                             (added 2026-09-26)
// DataInsightsUserProfile.institutionType — ACADEMIC |
//                             NGO_NONPROFIT_RESEARCH |
//                             MULTILATERAL_MARKET_INTELLIGENCE |
//                             COMMERCIAL_MARKET_INTELLIGENCE |
//                             INDIVIDUAL_RESEARCHER (added 2026-09-26)
// User.platformStaffRole   — NONE | SUPPORT | SUPER_ADMIN
// User.status               — INVITED | ACTIVE | DEACTIVATED
// PartnerRole.roleType      — CLIENT | MANUFACTURER | SUPPLIER |
//                             FREIGHT_FORWARDER | WAREHOUSING | LOGISTICS
// Partner.approvalStatus    — PENDING | APPROVED | REMOVED
// PartnerCertification.type — ISO_13485 | ISO_9001 | ISO_14001 | OTHER_ISO |
//                             FDA_REGISTRATION | GMP | GDP | MIA | WDA | OTHER
// SupplierEnquiry.responseStatus — QUOTED | DECLINED | NO_RESPONSE | WAITING
// ProductMaster.sourceStandard — WHO_EML | HS_CODE | UNSPSC | GS1_GTIN | INTERNAL
// ProductAttributeDefinition.dataType — STRING | NUMBER | BOOLEAN | ENUM
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Organization — the tenant root (see naming note at top of file)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // used in URLs / subdomains
  status    String   @default("PILOT") // see allowed values reference above
  /// One of the six values in the allowed values reference above (expanded
  /// 2026-09-26 — see claude/stakeholder-taxonomy-research.md). Drives which
  /// default role template createOrganizationWithDefaultRoles gives it and
  /// which app(s) it's steered toward — not an access-control boundary by
  /// itself (RLS/role permissions still do the actual enforcing).
  type      String   @default("PROCUREMENT_SERVICE_AGENT")
  /// Added 2026-09-26 — drives the personalized "powered by Universe"
  /// header every app shows (see @universe/ui's OrgHeader): the org's own
  /// logo when set, falling back to its name in text when not (most orgs
  /// won't have one at pilot launch — there's no upload flow yet, this is
  /// set directly for now). Expected to be a public HTTPS URL (e.g. blob
  /// storage) once a real upload path exists; nothing validates that yet.
  logoUrl   String?
  /// Added 2026-09-26 for per-organization brand personalization (see
  /// claude/org-onboarding-data-model.md's "brand implementation" section
  /// and OrgHeader) — deliberately minimal: just enough to make an org's
  /// Universe experience feel like theirs (a coloured accent under the
  /// header) without deep theming (no per-org fonts/full app reskinning —
  /// Universe keeps one consistent design language across every app).
  /// Hex string, e.g. "#1B203D". Falls back to Universe's own default
  /// header styling when unset.
  primaryColor   String?
  /// Same as primaryColor — used for the sign-in/out button and other
  /// small accents. Falls back to Universe's own default when unset.
  secondaryColor String?
  /// Universal onboarding fields added 2026-09-26 — see
  /// claude/org-onboarding-data-model.md ("Universal fields") and the
  /// admin-onboarding-intake-spec.md Phase 1 this implements. All nullable:
  /// most existing organizations (provisioned before this existed) won't
  /// have these filled in retroactively unless someone goes back and adds
  /// them — that's fine, they're enrichment, not required for the platform
  /// to function.
  /// Legal/registered name, if different from the trading/display name
  /// already held in `name` (e.g. "Unimed Procurement Services Limited" vs.
  /// the display name "Unimed"). Null means `name` doubles as both.
  legalName                  String?
  /// See allowed values reference above.
  legalEntityType            String?
  countryOfRegistrationCode  String?
  countryOfRegistration      Country? @relation("OrganizationCountryOfRegistration", fields: [countryOfRegistrationCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  registrationNumber         String?
  website                    String?
  /// The org's main point of contact for onboarding/relationship purposes —
  /// deliberately separate from any platform User, since the person who
  /// signs the data-sharing agreement or answers onboarding questions is
  /// often not the same person who logs into Universe day to day.
  primaryContactName         String?
  primaryContactTitle        String?
  primaryContactEmail        String?
  primaryContactPhone        String?
  /// See allowed values reference above.
  onboardingSource           String?
  notes                      String?  @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  roles            Role[]
  partners         Partner[]
  projects         Project[]
  productLines     ProductLine[]
  dataSharingConsents DataSharingConsent[]
  productSourceApprovals ProductSourceApproval[]
  supplierProfile  SupplierProfile?
  supplierProducts SupplierProduct[]
  supplierCountryPresence SupplierCountryPresence[]
  supplierLeadsAsSupplier SupplierLead[] @relation("SupplierLeadSupplier")
  supplierLeadsAsBuyer    SupplierLead[] @relation("SupplierLeadBuyer")
  /// Added 2026-10-02 — see StakeholderRegistryEntry's doc comment
  /// (duplicate-prevention + identity-consent scaffolding).
  stakeholderRegistryEntries StakeholderRegistryEntry[]
  /// Added 2026-10-02 — ProductMaster entries this org originally
  /// contributed (see ProductMaster.addedByOrganizationId's doc comment).
  productMastersAdded        ProductMaster[]
  /// Added 2026-10-07 — compliance-standards-gap-analysis.md Gap 1/9.
  fieldChangeLogs             FieldChangeLog[]
  /// Added 2026-10-07 — compliance-standards-gap-analysis.md Gap 4.
  riskAssessments             RiskAssessment[]
  /// Added 2026-10-07 — GDP gap-closing build, Gap 3 (Standards & Evidence
  /// scaffolding): each organisation builds its own catalog of standards.
  evidenceStandardDefinitions EvidenceStandardDefinition[]
  stakeholderEvidenceRecords  StakeholderEvidenceRecord[]
  /// Added 2026-10-07 — GDP gap-closing build, Gaps 5/6 (batch
  /// traceability + cold-chain temperature logging).
  productBatches              ProductBatch[]
  batchTemperatureLogs        BatchTemperatureLog[]
  /// Added 2026-10-07/08 (follow-up frontend pass) — Gap 7.
  controlledDocuments         ControlledDocument[]
  /// Added 2026-10-07 — organizationId backfill, see each model's doc
  /// comment (compliance-standards-gap-analysis.md Gap 1 cross-check).
  partnerCertifications        PartnerCertification[]
  partnerCompanyChecks         PartnerCompanyCheck[]
  partnerApprovalHistoryEntries PartnerApprovalHistory[]

  // Onboarding data model, 2026-09-26 (admin-onboarding-intake-spec.md
  // Phase 1) — universal "countries of operation" plus one optional
  // category-specific detail relation per Organization.type value. An org
  // has at most one of these populated, matching whichever category it is;
  // nothing enforces that at the database level (same as Organization.type
  // itself — see its own doc comment), application code is expected to
  // only populate the one relation matching the org's actual type.
  countryPresence         OrganizationCountryPresence[]
  procurementAgentProfile ProcurementAgentProfile?
  tenderingBodyProfile    TenderingBodyProfile?
  manufacturerProfile     ManufacturerProfile?
  manufacturerSites       OrganizationManufacturerSite[]
  funderProfile           FunderProfile?
  dataInsightsUserProfile DataInsightsUserProfile?
  /// The inverse side of TenderingBodyProfile.procurementAgentOrganization —
  /// every TenderingBodyProfile row that names THIS org as the agent it
  /// uses. Lets a procurement-agent org eventually be asked "which
  /// tendering bodies use us" without a new query shape.
  tenderingBodiesUsingAsAgent TenderingBodyProfile[] @relation("TenderingBodyProcurementAgent")

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// Identity, roles & permissions (Universe's own app-level RBAC — distinct
// from PartnerRole below, which classifies real-world companies, not users)
// ---------------------------------------------------------------------------

/// Onboarding is admin-driven, not self-service: a platform-staff member or
/// an org admin creates this row via the Admin app — email, name,
/// organization, and role(s) all set up front, status INVITED, entraObjectId
/// left null. The very first time that email successfully signs in through
/// the Universe CIAM tenant, the auth guard links the verified identity to
/// this row by matching email and flips status to ACTIVE. From that point on
/// the person is recognized by entraObjectId, never by email lookup again.
model User {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entraObjectId     String?      @unique
  email             String       @unique
  forename          String
  surname           String
  jobTitle          String?
  status            String       @default("INVITED") // see allowed values reference above
  platformStaffRole String       @default("NONE")
  invitedById       String?
  invitedBy         User?        @relation("UserInvitedBy", fields: [invitedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitedUsers      User[]       @relation("UserInvitedBy")
  invitedAt         DateTime     @default(now())
  firstSignInAt     DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  projectLeads       ProjectLead[]
  userRoles          UserRole[]
  uploadedDocuments  ProjectDocument[]
  recordedPrices     ProductPriceHistory[]
  acceptedConsents   DataSharingConsent[]
  createdSupplierProducts SupplierProduct[]
  /// Added 2026-09-30 — see ProjectStatusHistory model.
  recordedProjectStatusChanges ProjectStatusHistory[]
  /// Added 2026-10-07 — see RiskAssessment.owner.
  ownedRiskAssessments RiskAssessment[]
  /// Added 2026-10-07/08 (follow-up frontend pass) — Gap 7.
  approvedControlledDocuments ControlledDocument[]

  @@index([organizationId])
  @@map("users")
}

/// An app-scoped role BELONGING TO ONE ORGANIZATION. organizationId is
/// nullable only for the small set of platform-level role templates every
/// org can clone from.
model Role {
  id             String        @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  description    String?
  appScope       String
  createdAt      DateTime      @default(now())

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name, appScope])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role   Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Partners — real-world companies a tenant does business with (2026-09-24,
// replaces the earlier flat Client/Contact model). One row per real company;
// PartnerRole says what role(s) it plays. The same real company (e.g. a
// freight forwarder that's also a warehousing provider) is ONE Partner row
// with multiple PartnerRole entries, not multiple disconnected records.
// ---------------------------------------------------------------------------

model Partner {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  /// Lowercased, punctuation/legal-suffix-stripped version of `name`, used
  /// for de-duplication and fuzzy matching against messy free-text company
  /// names entered elsewhere (e.g. historical imports).
  normalizedName String
  countryCode    String?      // ISO 3166-1 alpha-2, see Country reference table below
  website        String?
  approvalStatus String       @default("PENDING") // see allowed values reference above
  /// Added 2026-10-02 — risk-tiering model (High/Medium/Low, driving what
  /// documentation is required). Applies to any role, not just Supplier/
  /// Manufacturer — a freight forwarder or warehousing partner on a
  /// GDP-impacting lane can be High Risk too.
  riskTier       String?      // HIGH | MEDIUM | LOW
  companyRegistrationNumber String?
  vatNumber      String?
  /// Added 2026-10-02 — see StakeholderRegistryEntry's doc comment.
  /// Links this tenant-private Partner to the shared, cross-tenant
  /// registry row for the same real-world company, so (a) a duplicate-
  /// prevention prompt can be shown to any other organisation adding the
  /// same stakeholder, and (b) identity-visibility gating in the Universe
  /// Product Database has a real, de-duplicated company to key off.
  registryEntryId String?
  registryEntry   StakeholderRegistryEntry? @relation(fields: [registryEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Updated 2026-10-02 — identity-level registry matching (generic fields
  /// only: name/country/registration number — never anything from the
  /// adding organisation's own records) is now mandatory for every Partner
  /// and does NOT depend on this flag; it always runs so autopopulate and
  /// duplicate-prevention stay accurate across the platform. This field is
  /// reserved for a future, separate consent that would let a Partner share
  /// relationship-specific data (e.g. pricing) with the particular
  /// organisation that created this record — not wired to anything yet.
  sharedWithUniverseRegistry Boolean @default(false)
  /// Annual "Bona Fide re-check" generalized to any role with a
  /// re-approval cadence, rather than duplicating this pair of dates on
  /// every *Detail table.
  lastApprovalReviewDate DateTime?
  nextApprovalReviewDue  DateTime?
  isArchived     Boolean      @default(false)
  archivedAt     DateTime?
  archivedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  roles            PartnerRole[]
  certifications   PartnerCertification[]
  approvalHistory  PartnerApprovalHistory[]
  supplierDetail   SupplierDetail?
  manufacturerDetail ManufacturerDetail?
  freightForwarderDetail FreightForwarderDetail?
  clientDetail     ClientDetail?
  warehousingDetail WarehousingDetail?
  /// Added 2026-10-03 — standard company checks/documents/certificates
  /// already applied to every stakeholder role (see showVerificationPacket
  /// on the New Stakeholder form); financial information is the other
  /// half of that same "standard for all stakeholders" requirement, not
  /// role-gated either.
  financialDetail  PartnerFinancialDetail?
  manufacturerSites ManufacturerSite[]
  companyChecks    PartnerCompanyCheck[]
  contacts         Contact[]
  projectsAsClient Project[]              @relation("ProjectClient")
  linesAsManufacturer ProjectLine[]       @relation("LineManufacturer")
  linesAsSupplier  ProjectLine[]          @relation("LineSupplier")
  // linesAsFreightForwarder relation removed 2026-10-03 — ProjectLine no
  // longer has a freightForwarderId field (moved to Project). Historical
  // rows had this FK cleared by the migration before the column dropped.
  /// Added 2026-10-03 — freight moved from per-line to per-project (see
  /// Project's "Freight & Logistics" block below); this is the project-
  /// level freight-forwarder relation, distinct from the old per-line one
  /// above (kept only because historical ProjectLine rows may still
  /// reference it until this migration runs).
  projectsAsFreightForwarder Project[]   @relation("ProjectFreightForwarder")
  supplierEnquiries SupplierEnquiry[]
  productLinesAsSupplier ProductLine[]    @relation("ProductLineSupplier")
  productLinesAsManufacturer ProductLine[] @relation("ProductLineManufacturer")
  productSourceApprovalsAsManufacturer ProductSourceApproval[] @relation("ProductSourceManufacturer")
  productSourceApprovalsAsSupplier     ProductSourceApproval[] @relation("ProductSourceSupplier")
  /// Added 2026-10-07 — GDP gap-closing build, Gap 3. Evidence logged
  /// against this partner (any role) across whatever standards the
  /// organisation's own EvidenceStandardDefinition catalog defines.
  evidenceRecords  StakeholderEvidenceRecord[]
  /// Added 2026-10-07 — Gaps 5/6. This partner acting as a batch's
  /// manufacturer of record.
  productBatchesAsManufacturer ProductBatch[]

  @@index([organizationId])
  @@index([organizationId, normalizedName])
  @@index([registryEntryId])
  @@map("partners")
}

/// Many-to-many: one Partner can hold several roles at once, each
/// independently active/inactive (e.g. approved as a Supplier, later
/// removed as a Freight Forwarder without touching the Supplier role).
model PartnerRole {
  id        String   @id @default(uuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roleType  String   // see allowed values reference above
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([partnerId, roleType])
  @@map("partner_roles")
}

model SupplierDetail {
  partnerId          String  @id
  partner            Partner @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplierCode       String?
  productCategory    String? // see allowed values reference above (ProductCategory list)
  fdaRegistrationNumber String?
  /// "Scope of supply" checkboxes from Bioconnections FORM 008.1 (Devices /
  /// Equipment / Consumables / Services) — stored as a comma-separated list
  /// of ProductCategory-style tags rather than four booleans, so it grows
  /// with the taxonomy instead of needing a new column per category.
  scopeOfSupply      String?
  /// "Scope of services (e.g. warehousing, consultancy)" free-text field
  /// from the same form.
  scopeOfServicesDescription String? @db.NVarChar(Max)
  /// Unimed's Code of Conduct is sent to every approved supplier for
  /// "Read & Understood" acknowledgement; a copy is retained.
  /// The retained copy itself is a PartnerCertification
  /// (type: CODE_OF_CONDUCT_ACKNOWLEDGEMENT) — these two fields are just
  /// the quick-glance status.
  codeOfConductAcknowledged     Boolean  @default(false)
  codeOfConductAcknowledgedDate DateTime?

  @@map("partner_supplier_details")
}

model ManufacturerDetail {
  partnerId         String  @id
  partner           Partner @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partNumberConvention String?
  /// Kept for the common single-site case; multi-site manufacturers (the
  /// BD-folder pattern — one ISO 13485 cert per registered site) use the
  /// ManufacturerSite table below instead, which is the source of truth
  /// once more than one site exists.
  countryOfManufactureCode String?
  scopeOfSupply      String?
  scopeOfServicesDescription String? @db.NVarChar(Max)

  @@map("partner_manufacturer_details")
}

/// Added 2026-10-02. A manufacturer's registered manufacturing sites — a
/// real supplier folder, reviewed as a worked example,
/// shows a single manufacturer holding a SEPARATE ISO 13485 certificate per
/// site (Spain, USA, India, Singapore, Italy...), each independently dated
/// and re-verified. PartnerCertification.manufacturerSiteId (below) scopes
/// a certification to one of these sites when it's site-specific, or leaves
/// it null for a certification that covers the whole company.
model ManufacturerSite {
  id          String   @id @default(uuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  siteName    String
  countryCode String?
  address     String?  @db.NVarChar(Max)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  certifications PartnerCertification[]

  @@index([partnerId])
  @@map("partner_manufacturer_sites")
}

model FreightForwarderDetail {
  partnerId        String  @id
  partner          Partner @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Comma-separated FreightMode-style tags (AIR/SEA/LAND) this forwarder is
  /// approved to use.
  modesOfTransport String?
  /// Added 2026-10-02. These four fields are the standard checks expected
  /// of a freight forwarder handling pharmaceutical/GDP-sensitive product.
  iataDgrCertified   Boolean @default(false)
  aeoAccredited      Boolean @default(false)
  /// GDP-competent cold-chain/temperature-controlled transport capability.
  gdpTransportCapable Boolean @default(false)
  referencesProvided  Boolean @default(false)

  @@map("partner_freight_forwarder_details")
}

model ClientDetail {
  partnerId       String  @id
  partner         Partner @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Billing and delivery address split into standard address fields, each
  /// with its own country — added 2026-10-03. Every element is stored
  /// separately (not one free-text block) so address data is structured
  /// and usable across every app, not just displayed back as a blob.
  billingAddressLine1   String?
  billingAddressLine2   String?
  billingCity           String?
  billingRegion         String?
  billingPostcode       String?
  billingCountryCode    String?
  deliveryAddressLine1  String?
  deliveryAddressLine2  String?
  deliveryCity          String?
  deliveryRegion        String?
  deliveryPostcode      String?
  deliveryCountryCode   String?
  paymentTerms    String?
  /// Added 2026-10-03 — predefined standard product-category licences/
  /// permits this client holds (ProductLicensingType values, comma-
  /// joined — same fixed-choice convention as scopeOfSupply), replacing
  /// the old free-text field. productCategoryLicensingOtherNotes covers
  /// anything not on the predefined list, paired with OTHER above.
  productCategoryLicenses              String? @db.NVarChar(Max)
  productCategoryLicensingOtherNotes   String? @db.NVarChar(Max)
  destinationCountryRestrictionsNotes  String? @db.NVarChar(Max)
  /// Every pharmaceutical enquiry is checked against the Approved
  /// Customer Log before a quote proceeds.
  isPharmaApprovedCustomer Boolean @default(false)
  approvedCustomerLogRef   String?

  @@map("partner_client_details")
}

/// Added 2026-10-02. Warehousing didn't have its own detail table until
/// now — it's a distinct, governed partner relationship (own Technical
/// Agreement, own WDA, own GDP audit cadence), not a bare PartnerRole tag
/// with no fields behind it.
/// Added 2026-10-03. Standard financial/banking information for a
/// stakeholder — one per Partner, applies to every role (not gated to
/// manufacturer/supplier/etc, same reasoning as the Company Checks and
/// Documents/Certifications packet applying to all roles).
model PartnerFinancialDetail {
  partnerId         String  @id
  partner           Partner @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bankName          String?
  accountHolderName String?
  accountNumber     String?
  sortCode          String?
  iban              String?
  swiftBic          String?
  branchAddress     String? @db.NVarChar(Max)
  currencyCode      String?

  @@map("partner_financial_details")
}

model WarehousingDetail {
  partnerId    String  @id
  partner      Partner @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// The warehouse operates to its own WDA (Wholesale Distribution
  /// Authorisation) and MHRA-audited procedures.
  wdaNumber    String?
  /// The relationship is governed by a Technical Agreement defining
  /// GDP/WDA responsibilities for both parties. The agreement
  /// document itself is a PartnerCertification
  /// (type: TECHNICAL_AGREEMENT) — this is just the quick-reference number.
  technicalAgreementRef String?
  gdpAuditDate     DateTime?
  nextGdpAuditDue  DateTime?
  /// Monthly stock reconciliation between the warehouse's stock report
  /// and Unimed's project trackers — who at the warehouse that
  /// reconciliation is run with.
  monthlyReconciliationContact String?

  @@map("partner_warehousing_details")
}

/// One generic table for every certificate/registration/document type,
/// replacing repeated per-certificate column blocks
/// (ISO13485/Expiry/ISO9001/Expiry/...). Expanded 2026-10-02 after
/// reviewing a real manufacturer folder as a
/// worked example — that folder shows Unimed tracking far more per document
/// than just type/issued/expiry: a reference/certificate number, the
/// issuing or notified body, a revision (Declarations of Conformity get
/// re-issued on spec change, not just on expiry), and VERIFICATION as its
/// own dated event distinct from the certificate's own validity (e.g. the
/// same ISO 13485 cert independently re-verified through a different
/// notified body later). Also now the home for the "Supplier
/// Documentation" table rows from Bioconnections' own New Supplier form
/// (FORM 008.1) — ISO accreditation / Device Registration / Other
/// accreditation all map onto `type` + `referenceNumber` + `expiryDate`
/// here rather than needing their own columns.
model PartnerCertification {
  id         String    @id @default(uuid())
  /// Added 2026-10-07 (compliance-standards-gap-analysis.md Gap 1 cross-
  /// check) — denormalized the same way as every other tenant table.
  /// MISSING until now: this table (and PartnerCompanyCheck/
  /// PartnerApprovalHistory alongside it) carried no organizationId at
  /// all and was never added to row-level-security.sql's table list, so a
  /// raw query against it had no database-layer RLS backstop — only the
  /// partnerId -> Partner join gave it any tenant scoping, and only when
  /// a caller remembered to make that join. Backfilled from partnerId's
  /// own Partner.organizationId; see the migration for the backfill query.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partnerId  String
  partner    Partner   @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Scopes this certification to one of the manufacturer's registered
  /// sites (the BD pattern — one ISO 13485 cert per site) rather than the
  /// whole company. Null means company-wide.
  manufacturerSiteId String?
  manufacturerSite   ManufacturerSite? @relation(fields: [manufacturerSiteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Optionally scopes this document to one of the partner's Company
  /// Checks (e.g. a VAT Certificate upload attached to the "VAT
  /// Certificate" check) rather than the site above — the two scopes are
  /// independent and a document can carry either, both, or neither. Stores
  /// PartnerCompanyCheck.checkType directly (a free-text join key, same
  /// convention as `type` below) rather than a check's own id, since a
  /// partner has at most one row per checkType. Added 2026-10-02 alongside
  /// the "Add Check" picker UI, so documents/certificates can be related
  /// and logged against the specific check they evidence.
  relatedCompanyCheckType String?
  type       String    // see allowed values reference above
  referenceNumber String? // certificate/registration/licence number
  /// Declarations of Conformity and similar documents get re-issued on a
  /// spec change, tracked by revision rather than (or alongside) a new
  /// expiry date — e.g. the BD folder's "DoC VTF1007-02 Rev4".
  revision   String?
  /// Who issued or notified the certificate — e.g. "BSI", "TÜV", a
  /// national regulatory authority's name. For device registrations this
  /// is the destination country/regulator (e.g. "TMDA Tanzania").
  issuingBody String?
  issuedDate DateTime?
  expiryDate DateTime?
  /// Pharma certs are verified against the relevant Regulatory Authority
  /// database (e.g. MHRA GMDP/EudraGMDP),
  /// non-pharma certs via the accreditation body's own online portal —
  /// and the verification itself must be saved as evidence. This is a
  /// separate dated event from the certificate's own issue/expiry, which
  /// is exactly what the BD folder's duplicate "verification ... EB"
  /// entries (the same cert re-verified via Emergo by UL after the
  /// original) demonstrate.
  verifiedAt   DateTime?
  verifiedById String?
  /// CURRENT | ARCHIVED — superseded/expired documents move to ARCHIVED
  /// rather than being deleted, preserving the audit trail (mirrors the
  /// BD folder's own Archive subfolders).
  status     String    @default("CURRENT")
  notes      String?   @db.NVarChar(Max)
  documentId String?
  document   ProjectDocument? @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt  DateTime  @default(now())

  @@index([partnerId])
  @@index([expiryDate])
  @@index([manufacturerSiteId])
  @@index([organizationId])
  @@map("partner_certifications")
}

/// Added 2026-10-02 from Bioconnections' "Company Checks" table (FORM
/// 008.1): UK Companies House Registration, Other National Company
/// Registration, VAT Certificate, Website, Financial Credit Status,
/// Location, Business Insurance — each a dated YES/N-A check with an
/// optional reference/source and comment, distinct in shape from
/// PartnerCertification (which tracks documents with their own
/// issue/expiry) — these are verification CHECKS Unimed performs, not
/// documents the stakeholder supplies.
model PartnerCompanyCheck {
  id          String   @id @default(uuid())
  /// Added 2026-10-07 — same RLS-gap fix as PartnerCertification above.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checkType   String   // see allowed values reference above (PartnerCompanyCheckType)
  /// Only meaningful when checkType == "OTHER" — the user-entered label
  /// for a check not on the predefined list (e.g. "Export Licence Check").
  /// Added 2026-10-02 alongside the "Add Check" picker UI.
  customLabel String?
  result      String   // YES | NO | NOT_APPLICABLE
  checkedDate DateTime?
  /// e.g. the Companies House reference number, or the credit-check
  /// source/provider name — "State reference:" / "State source:" on the
  /// Bioconnections form.
  referenceOrSource String?
  comment     String?  @db.NVarChar(Max)
  createdAt   DateTime @default(now())

  @@index([partnerId])
  @@index([organizationId])
  @@map("partner_company_checks")
}

/// Audit trail mirroring QA's existing HISTORY sheets: removal/reinstatement
/// events, alongside Partner.approvalStatus for the current state.
model PartnerApprovalHistory {
  id           String    @id @default(uuid())
  /// Added 2026-10-07 — same RLS-gap fix as PartnerCertification above.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partnerId    String
  partner      Partner   @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action       String    // e.g. "APPROVED" | "REMOVED" | "REINSTATED" — free text for now
  reason       String?   @db.NVarChar(Max)
  /// Added 2026-10-07 (compliance-standards-gap-analysis.md Gap 2) — the
  /// exact certification/"e-signature meaning" statement text shown to the
  /// approver at the moment of this action, captured verbatim (not just a
  /// version number) so the record is self-contained even if the
  /// statement's wording is edited later. Null for actions recorded before
  /// this existed, or for an action type that has no statement defined.
  /// See apps/api/src/common/certification-statements.ts.
  certificationStatement String? @db.NVarChar(Max)
  actionDate   DateTime  @default(now())
  actionById   String?

  @@index([partnerId])
  @@index([organizationId])
  @@map("partner_approval_history")
}

/// Added 2026-10-01 for the Quality Assurance section (round 3 feedback).
/// A standing, organization-owned "approved sourcing relationship": this
/// tenant has reviewed and approved buying a specific ProductMaster
/// commodity from a specific manufacturer (optionally via a specific
/// supplier) — independent of any one ProjectLine/order. This is
/// deliberately a NEW, explicit decision by Lewis (2026-10-01, via
/// AskUserQuestion) over the cheaper alternative (computing "qualified"
/// purely from ProjectLine history) — see architecture-decisions.md's
/// "Quality Assurance" section for the full rationale: an order line
/// existing does not mean anyone ever reviewed/approved that sourcing
/// combination, so "qualified" needed its own first-class record.
///
/// A ProductMaster+manufacturer(+supplier) combination is only ever
/// APPROVED here as a deliberate QA action (see
/// ProductSourceApprovalsService) — never auto-created from order
/// activity. The QA dashboard's "qualified products" figure counts
/// combinations that are APPROVED here AND whose manufacturer (and
/// supplier, when set) currently have Partner.approvalStatus == APPROVED
/// with no expired PartnerCertification — see
/// ProductSourceApprovalsService.getQualificationStatus for the exact
/// cross-reference logic.
model ProductSourceApproval {
  id               String        @id @default(uuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productMasterId  String
  productMaster    ProductMaster @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manufacturerId   String
  manufacturer     Partner       @relation("ProductSourceManufacturer", fields: [manufacturerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Optional — a product+manufacturer combination can be approved before a
  /// specific supplier is attached, or approved generically with no
  /// supplier at all (direct-from-manufacturer sourcing).
  supplierId       String?
  supplier         Partner?      @relation("ProductSourceSupplier", fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status           String        @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedAt       DateTime?
  approvedById     String?
  /// Optional QA review cadence — when set and in the past, the dashboard
  /// flags this as a stale approval needing re-review, same spirit as
  /// PartnerCertification.expiryDate.
  nextReviewDue    DateTime?
  notes            String?       @db.NVarChar(Max)
  isArchived       Boolean       @default(false)
  archivedAt       DateTime?
  archivedById     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([organizationId])
  @@index([productMasterId])
  @@index([manufacturerId])
  @@index([supplierId])
  @@map("product_source_approvals")
}

model Contact {
  id             String  @id @default(uuid())
  organizationId String // denormalized from Partner for direct RLS scoping
  partnerId      String
  partner        Partner @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  email          String?
  phone          String?
  title          String?

  projectContacts ProjectContact[]

  @@index([organizationId])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Project — header record (see "HEADER + LINE PROJECTS" note at top of file)
// ---------------------------------------------------------------------------

model Project {
  id                       String       @id @default(uuid())
  organizationId           String
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referenceNumber          String
  title                    String
  category                 String // see allowed values reference above
  projectType              String // see allowed values reference above
  clientId                 String?
  client                   Partner?     @relation("ProjectClient", fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Optional, and only ever populated when an organization actually knows
  /// and wants to track it — corrected 2026-09-24: NOT a required structural
  /// concept. A procurement service agent's `client` may or may not be the
  /// actual funder, and is often not knowable to them at all.
  donorReference           String?
  deliveryCountryCode      String? // ISO 3166-1 alpha-2, see Country reference table below
  status                   String       @default("IDENTIFIED") // see allowed values reference above
  startDate                DateTime?
  dueDate                  DateTime?
  submissionDate           DateTime?
  managementResponsibility String?
  reasonForCancellation    String?
  /// Sub-state within COMPLETED only (DELIVERED -> FINANCIALLY_CLOSED ->
  /// CLOSEOUT_FILED) — added 2026-09-30 per procurement-lifecycle-
  /// benchmarking.md rec. #1: CIPS/UN/PAHO all treat post-award logistics,
  /// receipt and closeout as distinct stages our single COMPLETED status
  /// collapsed into one. Deliberately a sub-state field, not a sixth
  /// pipeline stage — see project-stage-navigation-plan.md.
  completionStage          String?      // see allowed values reference above
  projectNotes             String?      @db.NVarChar(Max)
  projectFolderUrl         String?
  isArchived               Boolean      @default(false)
  archivedAt               DateTime?
  archivedById             String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt


  // --- Freight & Logistics (moved here from ProjectLine 2026-10-03, per
  // Lewis's explicit request: freight is arranged once for the whole
  // project, not individually per line item, so re-entering/recomputing
  // it per line was both wrong and tedious. Each line's own client
  // invoice is now PRODUCT-ONLY (see ProjectLine's "Margin-based client
  // invoice build" doc comment) — freight is billed to the client as its
  // own separate project-level charge, confirmed with Lewis via
  // AskUserQuestion rather than guessed (the alternative, apportioning
  // freight across lines by quantity/value, was explicitly not chosen).
  // Incoterm and freight mode moved here too (previously on ProjectLine's
  // "Procurement" block) since they're also a per-project commercial
  // arrangement, not a per-line one. ---
  incoterm                 String?   // see allowed values reference above
  freightMode               String?   // see allowed values reference above
  freightForwarderId        String?
  freightForwarder          Partner?  @relation("ProjectFreightForwarder", fields: [freightForwarderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  freightCost                Decimal?  @db.Decimal(18, 2)
  freightCurrency            String?   @db.Char(3)
  /// Incoterms 2020's CIP term requires the seller to insure at a minimum
  /// of 110% of contract value — distinct from freightCost, which is the
  /// freight contract price itself, not the insured sum.
  insuredValue               Decimal?  @db.Decimal(18, 2)
  insuredCurrency            String?   @db.Char(3)
  /// The PREMIUM paid for freight insurance — distinct from insuredValue
  /// above (the sum insured/coverage amount). Assumed to share
  /// freightCurrency, same judgment call carried over from the per-line
  /// version of this field.
  freightInsuranceCost       Decimal?  @db.Decimal(18, 2)
  /// Any freight-related cost that isn't the core freight price or the
  /// insurance premium — customs duties, demurrage, documentation fees,
  /// etc. A single bucket for now (with a free-text description of what
  /// it covers), same v1 simplification carried over from the per-line
  /// version. Shares freightCurrency.
  freightAdditionalCost      Decimal?  @db.Decimal(18, 2)
  freightAdditionalCostDescription String? @db.NVarChar(Max)
  /// Computed server-side (freightCost + freightInsuranceCost +
  /// freightAdditionalCost, all in freightCurrency) — see
  /// ProjectsService.applyProjectFreightPricing.
  freightTotalCost           Decimal?  @db.Decimal(18, 2)
  /// Input: the markup % applied to freightTotalCost on the way to the
  /// freight charge shown to the client — kept separate from any one
  /// line's productMarginPercent, since freight is commonly marked up at
  /// a different rate (or not at all) from the product itself.
  freightMarginPercent       Decimal?  @db.Decimal(5, 2)
  /// Computed: freightTotalCost x freightMarginPercent / 100, in
  /// freightCurrency.
  freightMarginAmount        Decimal?  @db.Decimal(18, 2)
  /// Freight's own currency-conversion lock, same convention as the
  /// supplier/sales trios that remain on ProjectLine — see schema's
  /// "Currency conversion" doc comment there for the full mechanism.
  /// Recomputed only when freightCost/freightInsuranceCost/
  /// freightAdditionalCost/freightCurrency actually change.
  freightPriceLockedAt       DateTime?
  freightExchangeRateSnapshotId String?
  freightExchangeRateSnapshot ExchangeRateSnapshot? @relation("ProjectFreightRate", fields: [freightExchangeRateSnapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Freight's base-currency code lock, same convention as ProjectLine's
  /// reportingCurrencyCode — see that field's doc comment for the full
  /// mechanism (Universe is currency-agnostic; this records WHICH base
  /// currency freightTotalCostReportingCcy/freightInvoiceAmountReportingCcy
  /// below were locked in, in case the platform base currency ever
  /// changes historically).
  reportingCurrencyCode     String?   @db.Char(3)
  /// Base-currency equivalent of freightTotalCost — PRE-margin.
  freightTotalCostReportingCcy Decimal? @db.Decimal(18, 2)
  /// Base-currency equivalent of freightTotalCost x (1 + freightMarginPercent/100)
  /// — the WITH-margin figure actually charged to the client, in base
  /// currency. This (not freightTotalCostReportingCcy) is what the
  /// project/org financial rollups add into totalInvoiceValue, alongside
  /// each line's own salesTotalPriceReportingCcy.
  freightInvoiceAmountReportingCcy Decimal? @db.Decimal(18, 2)

  leads     ProjectLead[]
  contacts  ProjectContact[]
  lines     ProjectLine[]
  documents ProjectDocument[]
  /// Added 2026-09-30 — see ProjectStatusHistory model below.
  statusHistory ProjectStatusHistory[]

  // Reference numbers only need to be unique WITHIN an organization — two
  // different tenants can both have a "PROJ-001".
  @@unique([organizationId, referenceNumber])
  @@index([organizationId, status])
  @@index([clientId])
  @@index([freightForwarderId])
  @@map("projects")
}

/// Which fields are relevant at which Project.status, driving frontend
/// show/hide — added 2026-09-24. The database always keeps every field
/// available regardless of this config, so nothing is lost if a project
/// reopens or skips a phase; this only controls what the UI foregrounds.
/// One row per Project.status transition — added 2026-09-30 per
/// project-stage-navigation-plan.md. Exists because "time in stage" cannot
/// be computed honestly from Project.updatedAt: that timestamp changes on
/// ANY field edit (a note, a management-responsibility change), not just a
/// status change, so it would silently reset the clock. ProjectsService.update
/// inserts a new row here whenever dto.status differs from the project's
/// current status, inside the same withTenantContext transaction as the
/// rest of the update. Supports both HubSpot-style "latest time in stage"
/// (now/next-row minus this row's enteredAt) and "cumulative time in
/// stage" (summed across every row with this status, since a project can
/// re-enter a stage, e.g. SUBMITTED -> IN_PROGRESS -> SUBMITTED again) —
/// see procurement-lifecycle-benchmarking.md rec. #7.
model ProjectStatusHistory {
  id             String   @id @default(uuid())
  organizationId String // denormalized from Project for direct RLS scoping, same pattern as every other tenant table
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status         String // the stage being entered — see allowed values reference above (Project.status)
  enteredAt      DateTime @default(now())
  changedById    String?
  changedBy      User?    @relation(fields: [changedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId])
  @@index([projectId])
  @@map("project_status_history")
}

/// Days Remaining for Submission is intentionally NOT stored — it's derived
/// from dueDate/submissionDate and today's date, computed in the API/app
/// layer so it's never stale.

model ProjectLead {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([projectId, userId])
  @@map("project_leads")
}

model ProjectContact {
  projectId String
  contactId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([projectId, contactId])
  @@map("project_contacts")
}

// ---------------------------------------------------------------------------
// ProjectLine — one row per item/country/lot within a Project (2026-09-24,
// replaces the 1:1 ProjectProcurement/ProjectFinancials/ProjectLogistics
// design and absorbs what ProjectLineItem used to hold). Carries procurement,
// financial, and logistics fields generally (not just for pharma), plus the
// pharma-only batch block at the bottom.
// ---------------------------------------------------------------------------

model ProjectLine {
  id                            String    @id @default(uuid())
  organizationId                String // denormalized from Project for direct RLS scoping
  projectId                     String
  project                       Project   @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // --- Item identification ---
  clientProductDescription      String?   @db.NVarChar(Max)
  /// Once a product is identified/matched against the shared catalog. Not
  /// required — plenty of lines will never be matched, especially early on.
  productMasterId               String?
  productMaster                 ProductMaster? @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Category-specific refinement attributes (e.g. Cryovial -> size), keyed
  /// by ProductAttributeDefinition.attributeKey, stored as JSON text —
  /// pragmatic middle ground over a full EAV table; validated at the app
  /// layer against the matched product's category definitions.
  attributes                    String?   @db.NVarChar(Max)
  quantity                      Int?
  productCategory                String?  // see allowed values reference above

  // --- Procurement ---
  // incoterm/freightMode moved to Project (project-level, 2026-10-03) —
  // see Project's "Freight & Logistics" block. countryOfManufactureCode
  // and goodsManufacturedDate moved INTO this section 2026-10-03 (both
  // previously sat elsewhere — country under Item Identification,
  // manufactured date under Freight & Logistics — per Lewis's explicit
  // reorganisation request).
  countryOfManufactureCode       String?  // ISO 3166-1 alpha-2
  goodsManufacturedDate          DateTime?
  manufacturerId                String?
  manufacturer                  Partner?  @relation("LineManufacturer", fields: [manufacturerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplierId                    String?
  supplier                      Partner?  @relation("LineSupplier", fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clientPoNumber                String?
  clientPoReceiptDate           DateTime?
  /// The platform operator's own PO number raised to the supplier.
  internalPoNumber              String?
  internalPoDatePlaced          DateTime?
  /// GAD — confirm exact meaning/definition with Lewis (Goods Arrival Date?)
  gad                           DateTime?
  supplierGad                   DateTime?

  // --- Freight & logistics ---
  // Freight cost/vendor/terms fields (freightForwarderId, freightCost,
  // insuredValue, freightInsuranceCost, freightAdditionalCost,
  // freightTotalCost, freightMarginPercent/Amount, and their currency-
  // conversion locks below) moved to Project 2026-10-03 — see Project's
  // "Freight & Logistics" block. What stays here is per-line SHIPMENT
  // TRACKING: even when one freight contract covers a whole project,
  // different lines/lots can still be collected/delivered on different
  // dates, so these dates remain per-line.
  warehouseReferenceNumber      String?
  goodsCollectedDate            DateTime?
  goodsDeliveredToClientDate    DateTime?
  /// Renamed from promisedDeliveryDate 2026-10-03 per Lewis — "projected"
  /// reads less like a contractual promise and more like what it actually
  /// is, an internal planning estimate.
  projectedDeliveryDate         DateTime?
  actualDeliveryDate            DateTime?
  /// The quantity actually received from the supplier — added 2026-10-03
  /// specifically so supplierInFull below can be a real computed value
  /// rather than a manual guess; previously there was no field at all
  /// recording what was actually received, only what was ordered
  /// (quantity, above), so "in full" had nothing to compare against.
  quantityReceived              Int?
  /// Computed server-side 2026-10-03 (previously a manual dropdown) — see
  /// ProjectsService.computeOnTimeInFull. actualDeliveryDate <=
  /// projectedDeliveryDate (Unimed's own promise to the CLIENT was met).
  /// Null until both dates are set.
  internalOnTime                Boolean?
  /// Computed server-side 2026-10-03 (previously a manual dropdown) —
  /// goodsCollectedDate <= supplierGad (the SUPPLIER's own committed
  /// arrival/collection date was met). Judgment call: GAD/supplierGad's
  /// exact definitions are still an open question (see architecture-
  /// decisions.md "Open questions") — this is a reasonable reading given
  /// available fields, worth Lewis confirming once GAD's meaning is
  /// settled for good.
  supplierOnTime                Boolean?
  /// Computed server-side 2026-10-03 (previously a manual dropdown) —
  /// quantityReceived >= quantity. Null until quantityReceived is entered.
  supplierInFull                Boolean?

  // --- Financials ---
  supplierUnitPrice             Decimal?  @db.Decimal(18, 2)
  /// The total amount DUE to the supplier for this line — paired with
  /// supplierAmountPaid below, not a percentage. See that field's doc
  /// comment.
  supplierPaymentAmountTotal    Decimal?  @db.Decimal(18, 2)
  supplierPaymentCurrency       String?   @db.Char(3)
  supplierPaymentDate           DateTime?
  supplierDocumentsReceivedDate DateTime?
  /// The amount paid to the supplier so far. Added 2026-09-30, replacing
  /// supplierPaymentStatusPercent — see procurement-lifecycle-
  /// benchmarking.md rec. #2: a single percentage cannot distinguish
  /// delivery completeness from payment completeness (SAP Ariba/three-
  /// way-match convention stores amounts, derives percentage for
  /// display rather than storing it as source of truth). Remaining
  /// balance = supplierPaymentAmountTotal - supplierAmountPaid, computed
  /// in the API layer so it can't drift out of sync, same convention as
  /// grossMargin/margin below.
  supplierAmountPaid            Decimal?  @db.Decimal(18, 2)
  supplierPaymentStatus         String?   // see allowed values reference above
  /// Computed server-side as clientPaymentAmount / quantity (the full
  /// margin-based invoice build below) — not a manual entry any more, same
  /// convention as supplierPaymentAmountTotal. Kept as its own column
  /// (rather than always re-deriving it at read time) since it's a plain
  /// display convenience and the arithmetic is trivial to keep in sync.
  unitSalesPrice                Decimal?  @db.Decimal(18, 2)
  /// Computed server-side (2026-10-03 rework — see "Margin-based client
  /// invoice build" below) as (product cost + product margin) + (freight
  /// cost + freight margin), each side converted into THIS field's own
  /// clientPaymentCurrency. No longer free-text manual entry — same
  /// convention as supplierPaymentAmountTotal.
  clientPaymentAmount           Decimal?  @db.Decimal(18, 2)
  clientPaymentCurrency         String?   @db.Char(3)
  clientPaymentDate             DateTime?
  /// The platform operator's own invoice raised to the client.
  internalInvoiceNumber         String?
  internalInvoiceDate           DateTime?
  /// Legacy manual-entry fields, predating the margin-based invoice build
  /// below — kept for backward compatibility with any already-entered
  /// data, but no longer populated or read by ProjectsService. The
  /// equivalent figure going forward is the arithmetic difference between
  /// clientPaymentAmount and (supplierPaymentAmountTotal + freightTotalCost),
  /// computed at report time, not stored per line.
  grossMargin                   Decimal?  @db.Decimal(18, 2)
  margin                        Decimal?  @db.Decimal(5, 2)

  // --- Margin-based client invoice build (added 2026-10-03) ---
  // Lewis's full financial-field scoping request: the client invoice total
  // per line is now built, not typed in — (manufacturer/supplier product
  // total + a margin % on top) plus (freight total [price + insurance +
  // any additional cost] + a SEPARATE margin % on top), each side
  // converted into clientPaymentCurrency and summed. See
  // ProjectsService.applyPricing for the actual computation.
  /// Input: the markup % applied to supplierPaymentAmountTotal (the
  /// manufacturer/supplier product cost) on the way to the client invoice.
  productMarginPercent          Decimal?  @db.Decimal(5, 2)
  /// Computed: supplierPaymentAmountTotal x productMarginPercent / 100, in
  /// supplierPaymentCurrency — stored for transparency/audit, not just
  /// folded silently into clientPaymentAmount.
  productMarginAmount           Decimal?  @db.Decimal(18, 2)
  /// Input: the markup % applied to freightTotalCost (freight price +
  /// insurance + any additional cost) on the way to the client invoice —
  /// deliberately separate from productMarginPercent, since freight is
  /// commonly marked up at a different rate (or not at all) from the
  /// product itself.
  freightMarginPercent          Decimal?  @db.Decimal(5, 2)
  /// Computed: freightTotalCost x freightMarginPercent / 100, in
  /// freightCurrency.
  freightMarginAmount           Decimal?  @db.Decimal(18, 2)

  // --- Currency conversion (added 2026-10-02, generalized 2026-10-03) ---
  // Universe is a global, tenant-agnostic platform — NOT built around any
  // one organisation's home currency (corrected explicitly by Lewis
  // 2026-10-03: an earlier pass of this feature hardcoded Unimed's own
  // GBP reporting basis, which doesn't belong in a platform meant to be
  // currency-agnostic for every tenant). Every native-currency price gets
  // converted into ExchangeRatesService.DEFAULT_BASE_CURRENCY ("USD" — a
  // neutral computation/aggregation currency, not any one org's reporting
  // currency) at the FX rate for the day the price was last
  // entered/changed, and that conversion is LOCKED (never recomputed from
  // a later day's rate). This base-currency figure is what the dashboard
  // and per-project financial summaries roll up across lines/currencies —
  // their own currency SELECTOR then converts the base-currency rollup
  // into whichever currency the viewer picks, LIVE (today's rate, not
  // locked — a display lens, not a historical record). See
  // ExchangeRatesService.convertFromBase() for that live-conversion path.
  /// The base currency these *ReportingCcy fields are expressed in, fixed
  /// at the time of conversion and stored (not just assumed) so a later
  /// change to the platform's default base currency can't silently
  /// reinterpret an old, already-locked conversion.
  reportingCurrencyCode         String?   @db.Char(3)
  /// The calendar date supplierUnitPrice/quantity/supplierPaymentCurrency
  /// was last saved — i.e. the date whose snapshot supplierExchangeRateSnapshotId
  /// is locked to. Only recomputed when one of those three actually changes.
  supplierPriceLockedAt         DateTime?
  supplierExchangeRateSnapshotId String?
  supplierExchangeRateSnapshot  ExchangeRateSnapshot? @relation("LineSupplierRate", fields: [supplierExchangeRateSnapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Base-currency equivalent of supplierPaymentAmountTotal — PRE-margin
  /// (the product margin is a dimensionless %, so it's applied to this
  /// figure arithmetically at report time rather than needing its own
  /// locked base-currency column — see getFinancialSummary).
  supplierUnitPriceReportingCcy  Decimal?  @db.Decimal(18, 2)
  supplierTotalPriceReportingCcy Decimal?  @db.Decimal(18, 2)
  // freightPriceLockedAt/freightExchangeRateSnapshotId/
  // freightTotalCostReportingCcy moved to Project 2026-10-03, alongside
  // the rest of the per-line freight fields — see Project's "Freight &
  // Logistics" block.
  /// Repurposed 2026-10-03 (previously the manually-entered "sales" side's
  /// lock, back when unitSalesPrice/clientPaymentAmount were free text) —
  /// now locks the CLIENT INVOICE conversion: clientPaymentAmount's
  /// base-currency equivalent, i.e. the fully-margined, fully-combined
  /// per-line invoice total, which is what dashboard/project financial
  /// rollups actually sum across lines regardless of each line's own
  /// clientPaymentCurrency.
  salesPriceLockedAt            DateTime?
  salesExchangeRateSnapshotId   String?
  salesExchangeRateSnapshot     ExchangeRateSnapshot? @relation("LineSalesRate", fields: [salesExchangeRateSnapshotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// = salesTotalPriceReportingCcy / quantity — kept for symmetry with
  /// supplierUnitPriceReportingCcy, not independently meaningful.
  salesUnitPriceReportingCcy    Decimal?  @db.Decimal(18, 2)
  /// The base-currency equivalent of clientPaymentAmount (the fully-built
  /// invoice total) — THE figure every rollup/dashboard sums.
  salesTotalPriceReportingCcy   Decimal?  @db.Decimal(18, 2)

  // --- Pharma-only batch block (shown/required only when
  //     Project.projectType == "PHARMACEUTICAL") ---
  strength                      String?
  form                          String?
  packSize                      String?
  batchNumber                   String?
  /// Added 2026-10-07 (GDP gap-closing build, Gaps 5/6) — links this line
  /// to the first-class ProductBatch entity when one has been matched/
  /// created, so "every place batch X was shipped" is a direct indexed
  /// join instead of a free-text match on batchNumber above. Additive,
  /// not a replacement: batchNumber is kept, unvalidated, for lines that
  /// predate this or haven't been matched yet (see ProductBatch's doc
  /// comment and sop-driven-quality-roadmap.md Section A's migration
  /// note — existing free-text batchNumber data is not auto-migrated).
  productBatchId                String?
  productBatch                  ProductBatch? @relation(fields: [productBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expiryDate                    DateTime?
  storageConditions             String?
  dataLoggerReference           String?
  dataLoggerReportReviewed      Boolean?
  excursionReview               String?   @db.NVarChar(Max)
  customerApproved              Boolean?
  rpApproved                    Boolean?
  /// Marketing Authorization / Product License number
  maPl                          String?
  /// Which regulatory pathway qualified this product — added 2026-09-30
  /// per benchmarking doc rec. #4 (Global Fund PSM guidelines): pharma
  /// products must clear WHO Prequalification, a Stringent Regulatory
  /// Authority approval, or an Expert Review Panel approval (the latter
  /// capped at 12 months — see qualificationPathwayExpiryDate).
  qualificationPathway           String?   // see allowed values reference above
  /// Only meaningful when qualificationPathway == "ERP" — Global Fund
  /// caps an Expert Review Panel approval at a 12-month maximum contract
  /// duration.
  qualificationPathwayExpiryDate DateTime?

  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  supplierEnquiries             SupplierEnquiry[]
  priceHistory                  ProductPriceHistory[]

  @@index([organizationId])
  @@index([projectId])
  @@index([supplierId])
  @@index([manufacturerId])
  @@index([productBatchId])
  @@map("project_lines")
}

/// Turns the RFQ trail that's currently trapped in free-text Notes fields
/// (e.g. "1. Advanced Sterilization Products – No response... 2. Bailey
/// Instruments – declined...") into structured, reportable data.
model SupplierEnquiry {
  id             String    @id @default(uuid())
  organizationId String // denormalized for direct RLS scoping
  projectLineId  String
  projectLine    ProjectLine @relation(fields: [projectLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplierId     String
  supplier       Partner   @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dateContacted  DateTime?
  responseStatus String    @default("WAITING") // see allowed values reference above
  quotedPrice    Decimal?  @db.Decimal(18, 2)
  quotedCurrency String?   @db.Char(3)
  notes          String?   @db.NVarChar(Max)
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([projectLineId])
  @@map("supplier_enquiries")
}

// ---------------------------------------------------------------------------
// Documents (Project Checklist, Project Issues, Project Closeout Report,
// certification documents, etc.)
// ---------------------------------------------------------------------------

model ProjectDocument {
  id             String   @id @default(uuid())
  organizationId String // denormalized for direct RLS scoping
  /// Nullable since 2026-10-08 (stakeholder-evidence document upload —
  /// see claude/product-db-test-batch-import.md "Round 4"). A row with
  /// projectId null is a "standalone" document — uploaded against a
  /// StakeholderEvidenceRecord (or, in future, a ControlledDocument)
  /// rather than a Project. Everything else about it (blob storage,
  /// container-per-org, the SAS upload/download flow) is identical; only
  /// the owning-context FK differs. See documents-standalone.controller.ts.
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type           String // see allowed values reference above
  title          String
  url            String // blob storage URL (no SAS — see blob-storage.service.ts) or a legacy SharePoint link
  /// Added 2026-10-01 (Phase 2b, Blob Storage — see architecture-decisions.md
  /// "Document storage" decision). The blob's own path within its org's
  /// private container, e.g. "<uuid>-<original file name>" — kept separate
  /// from `url` (which is a full https:// endpoint, convenient for display
  /// and for the legacy SharePoint-link rows that predate this field) so
  /// BlobStorageService never has to parse a URL back apart to re-derive
  /// the blob name when minting a fresh read/delete SAS.
  blobName       String?
  fileName       String?
  fileSizeBytes  Int?
  mimeType       String?
  uploadedById   String?
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploadedAt     DateTime @default(now())

  partnerCertifications PartnerCertification[]
  /// Added 2026-10-07 — GDP gap-closing build, Gap 3.
  stakeholderEvidenceRecords StakeholderEvidenceRecord[]
  /// Added 2026-10-07/08 (follow-up frontend pass) — Gap 7.
  controlledDocuments ControlledDocument[]

  @@index([organizationId])
  @@map("project_documents")
}

// ---------------------------------------------------------------------------
// Products — three tables at three different grains (2026-09-24), plus the
// shared, non-tenant-scoped ProductMaster catalog. See the note at the top
// of this file, "PRODUCT CLASSIFICATION & THE SHARED CATALOG".
// ---------------------------------------------------------------------------

/// PO-line grain — matches the real data's actual grain (one row per
/// purchase order line; the same physical product can appear many times
/// with different POs, suppliers, prices). Tenant-scoped, unlike
/// ProductMaster below.
model ProductLine {
  id                       String    @id @default(uuid())
  organizationId           String
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerPoProductName    String
  /// GTIN captured as entered — Unimed's own GS1-assigned codes are expected
  /// to densely populate this from day one (owned data, no licensing
  /// question). Format-validated at the app layer, not pre-populated from
  /// any public catalog (no open bulk GTIN database exists — see
  /// architecture doc, "Sector-insights data strategy").
  gtin                     String?
  poNumber                 String?
  procurementOfficerId     String?
  poDate                   DateTime?
  productType              String?
  supplierId               String?
  supplier                 Partner?  @relation("ProductLineSupplier", fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplierProductDescription String? @db.NVarChar(Max)
  manufacturerId           String?
  manufacturer              Partner? @relation("ProductLineManufacturer", fields: [manufacturerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manufacturerPartNumber   String?
  unitOfSupply              String?
  exactMatchFlag             Boolean?
  matchNotes                 String? @db.NVarChar(Max)
  storageRequirement          String?
  productCertificationExpiry DateTime?
  /// Once matched against the shared catalog.
  productMasterId          String?
  productMaster             ProductMaster? @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  priceHistory              ProductPriceHistory[]

  @@index([organizationId])
  @@index([gtin])
  @@index([productMasterId])
  @@map("product_lines")
}

/// The shared, deduplicated commodity catalog — NOT tenant-scoped (see note
/// at top of file). Seeded from open reference data (HS codes, the WTO
/// Medical Goods List, UNSPSC once the embedding-terms addendum is signed,
/// the WHO Essential Medicines List) plus Unimed's own owned GTIN data, and
/// grown organically as tenants' real products get matched/added over time.
model ProductMaster {
  id                          String    @id @default(uuid())
  name                        String
  /// Hierarchical category path, e.g. "Laboratory Consumables.Cryovial" —
  /// what ProductAttributeDefinition below is keyed against.
  category                    String
  hsCode                      String?
  unspscCode                  String?
  /// A representative/canonical GTIN where one clearly applies; a given
  /// commodity type may have many manufacturer-specific GTINs in practice —
  /// this is not meant to be exhaustive.
  gtin                        String?
  standardUnit                String?
  canonicalManufacturerPartNumber String?
  expectedQualityDocumentation String? @db.NVarChar(Max)
  /// Where this entry's classification data originally came from — an
  /// explicit provenance trail given the mixed licensing landscape across
  /// sources. See allowed values reference above.
  sourceStandard               String?
  isArchived                   Boolean  @default(false)
  /// Attribution — added 2026-10-02 (sop-driven-quality-roadmap.md Section
  /// B1): which organisation originally contributed this entry, and in
  /// what capacity, so the standardised central catalogue still records
  /// provenance even though every org's contributions are normalized into
  /// the same shape. Null for the originally-seeded reference data (HS
  /// codes, WHO EML, etc.) that predates any org contribution. Not used
  /// for access control — ProductMaster stays globally readable/writable
  /// the same as today; this is a provenance tag only.
  addedByOrganizationId        String?
  addedByOrganization          Organization? @relation(fields: [addedByOrganizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Denormalized copy of Organization.type at the moment of contribution
  /// (deliberately frozen, not a live lookup) — e.g. "PROCUREMENT_SERVICE_AGENT"
  /// for Unimed adding a product while building a project, vs.
  /// "MANUFACTURER" for a company adding its own. Frozen so the historical
  /// record of who-added-what-in-what-capacity doesn't silently change if
  /// an organisation's type is ever edited later.
  addedByOrganizationType      String?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  attributeDefinitions ProductAttributeDefinition[]
  projectLines         ProjectLine[]
  productLines         ProductLine[]
  priceHistory         ProductPriceHistory[]
  supplierProducts     SupplierProduct[]
  productSourceApprovals ProductSourceApproval[]
  /// Added 2026-10-07 — GDP gap-closing build, Gaps 5/6.
  productBatches         ProductBatch[]

  @@index([category])
  @@index([hsCode])
  @@index([unspscCode])
  @@index([gtin])
  @@index([addedByOrganizationId])
  @@map("product_master")
}

/// Category-scoped refinement field definitions — what powers "type
/// Cryovial, get prompted for size". Not tenant-scoped, same as
/// ProductMaster; defines the schema for the `attributes` JSON on
/// ProjectLine/ProductLine, keyed by category so it applies to every product
/// in that category rather than needing a new database column per type.
model ProductAttributeDefinition {
  id            String  @id @default(uuid())
  category      String
  attributeKey  String
  label         String
  dataType      String  // see allowed values reference above
  /// JSON array of allowed values, only used when dataType == "ENUM".
  enumOptions   String? @db.NVarChar(Max)
  required      Boolean @default(false)
  sortOrder     Int     @default(0)

  productMaster ProductMaster[]

  @@unique([category, attributeKey])
  @@map("product_attribute_definitions")
}

/// Daily FX reference-rate cache (added 2026-10-02) — see ProjectLine's
/// "Currency conversion" block above. One row per (date, baseCurrencyCode):
/// fetched lazily from Frankfurter (frankfurter.app, free/no-key, ECB
/// reference rates) the first time a line's price needs converting for
/// that calendar date, then reused for every other conversion on the same
/// date — so this is a cache keyed by day, not a literal cron-driven daily
/// job. NOT tenant-scoped: an FX rate is the same fact for every
/// organization, same reasoning as Country/Region reference data below.
model ExchangeRateSnapshot {
  id               String   @id @default(uuid())
  /// The calendar date these rates apply to. May be earlier than the date
  /// actually requested — if that date fell on a weekend/holiday with no
  /// published ECB rate, Frankfurter returns its most recent prior business
  /// day's rates instead, and we store the date IT reports, not the one we
  /// asked for, so lockedAt fields always match a real published rate.
  date             DateTime @db.Date
  baseCurrencyCode String   @db.Char(3)
  /// JSON map of currencyCode -> units of that currency per 1 unit of
  /// baseCurrencyCode — i.e. Frankfurter's own `?from=<base>` response
  /// shape, stored verbatim rather than normalized into rows (a handful of
  /// lookups per snapshot, never queried by rate value itself).
  ratesJson        String   @db.NVarChar(Max)
  source           String   @default("frankfurter")
  fetchedAt        DateTime @default(now())

  projectLinesAsSupplierRate ProjectLine[] @relation("LineSupplierRate")
  // projectLinesAsFreightRate relation removed 2026-10-03 — see note on
  // Partner.linesAsFreightForwarder above; same migration.
  /// Added 2026-10-03 — the project-level freight lock, see Project's
  /// "Freight & Logistics" block below.
  projectsAsFreightRate      Project[]     @relation("ProjectFreightRate")
  projectLinesAsSalesRate    ProjectLine[] @relation("LineSalesRate")

  @@unique([date, baseCurrencyCode])
  @@map("exchange_rate_snapshots")
}

/// Insert-only — pricing is stored and added to, never overwritten, so
/// trend-over-time reporting is a query away. Tenant-scoped (pricing IS
/// commercially sensitive, unlike the shared ProductMaster catalog itself).
model ProductPriceHistory {
  id              String    @id @default(uuid())
  organizationId  String
  productLineId   String?
  productLine     ProductLine? @relation(fields: [productLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectLineId   String?
  projectLine     ProjectLine? @relation(fields: [projectLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productMasterId String?
  productMaster   ProductMaster? @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unitPrice       Decimal   @db.Decimal(18, 2)
  currency        String    @db.Char(3)
  effectiveDate   DateTime  @default(now())
  recordedById    String?
  recordedBy      User?     @relation(fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt       DateTime  @default(now())

  @@index([organizationId])
  @@index([productMasterId])
  @@map("product_price_history")
}

// ---------------------------------------------------------------------------
// Reference data — Countries & WHO Regions (2026-09-24). Not tenant-scoped.
// Lets country fields (Partner.countryCode, Project.deliveryCountryCode,
// ProjectLine.countryOfManufactureCode) group into the six WHO regions
// (AFRO, AMRO, EMRO, EURO, SEARO, WPRO) — how humanitarian health data is
// normally reported — rather than only raw country-by-country.
// ---------------------------------------------------------------------------

model Region {
  code String    @id // e.g. "AFRO", "AMRO", "EMRO", "EURO", "SEARO", "WPRO"
  name String

  countries Country[]

  @@map("regions")
}

model Country {
  code       String  @id // ISO 3166-1 alpha-2
  name       String
  regionCode String?
  region     Region? @relation(fields: [regionCode], references: [code], onDelete: NoAction, onUpdate: NoAction)

  supplierCountryPresence SupplierCountryPresence[]

  // Onboarding data model, 2026-09-26
  organizationsRegisteredHere Organization[] @relation("OrganizationCountryOfRegistration")
  organizationCountryPresence OrganizationCountryPresence[]
  manufacturerSites           OrganizationManufacturerSite[]

  @@map("countries")
}

// ---------------------------------------------------------------------------
// Data governance — consent for anonymized cross-tenant insights (2026-09-24)
// Schema hook only; the actual consent terms need real legal review before
// any aggregation pipeline is built. See architecture doc, "Sector-insights
// data strategy".
// ---------------------------------------------------------------------------

/// One row per organization (organizationId is @unique, not just indexed —
/// see packages/db/src/organizations.ts header comment, added 2026-09-24):
/// consent is contractual, agreed as part of Universe's privacy policy /
/// data sharing agreement at onboarding, not a self-service per-category
/// toggle. createOrganizationWithDefaultRoles() creates this row for every
/// org unconditionally, so "does this org have data-sharing consent" is
/// always `revokedAt IS NULL` on this single row, never "does a row exist".
/// If terms are ever renegotiated for one org, that's `revokedAt` set on
/// this row by platform staff — not a new row (the Insights ETL only ever
/// needs to know the CURRENT state, not history).
model DataSharingConsent {
  id             String    @id @default(uuid())
  organizationId String    @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Which data categories this org's agreement covers — JSON array, e.g.
  /// ["pricing","specifications","quality"]. Defaults to
  /// DEFAULT_DATA_SHARING_SCOPE (packages/db/src/organizations.ts) for every
  /// org since the current terms are blanket, not pick-and-choose; kept as a
  /// scoped list (not a boolean) so a future narrower terms version has
  /// somewhere to go without a schema change.
  scope          String    @db.NVarChar(Max)
  termsVersion   String
  acceptedById   String?
  acceptedBy     User?     @relation(fields: [acceptedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  acceptedAt     DateTime  @default(now())
  revokedAt      DateTime?

  @@map("data_sharing_consents")
}

// ---------------------------------------------------------------------------
// Supplier/manufacturer marketplace (added 2026-09-24 — per Lewis, see
// "Supplier/manufacturer marketplace" in the architecture doc). A SUPPLIER-
// type Organization publishes its own profile, product catalog, and country
// presence, consented and visible to every other organization on the
// platform for search-and-add into their projects — the opposite anonymity
// model from DataSharingConsent's aggregate pool above: here the whole point
// is for suppliers/manufacturers to be identifiable and reachable, in
// exchange for exposure to buyer demand across the platform.
//
// ACCESS MODEL — deliberately NOT the tenant-isolation RLS pattern used
// everywhere else in this file. These three tables need READ access from
// every authenticated user on the platform (that's the product), but WRITE
// access only from the owning supplier organization's own users. See
// infra/sql/supplier-directory-rls.sql for the actual policy — a read-
// everyone / write-owner-only predicate, distinct from
// rls.fn_tenantAccessPredicate's read-and-write-scoped-to-caller's-own-org
// default-deny model. organizationId is still denormalized onto every row
// here for that write-side scoping, consistent with the rest of the schema.
// ---------------------------------------------------------------------------

/// One row per SUPPLIER-type Organization — its public-facing profile. Not
/// searchable/visible to other organizations until publishedAt is set
/// (lets a supplier complete onboarding before appearing live).
model SupplierProfile {
  id             String    @id @default(uuid())
  organizationId String    @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  description    String?   @db.NVarChar(Max)
  website        String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  publishedAt    DateTime?
  /// Supplier/Distributor onboarding fields, added 2026-09-26 — see
  /// claude/org-onboarding-data-model.md's "Supplier / Distributor" section.
  /// Stored here rather than a new table since SupplierProfile is already
  /// the 1:1 marketplace profile for SUPPLIER-type orgs; MANUFACTURER-type
  /// orgs share this same table (see ManufacturerProfile's doc comment) but
  /// these four fields are only meaningful for SUPPLIER and are expected to
  /// stay null on a manufacturer's row.
  principalManufacturersRepresented String? @db.NVarChar(Max) // JSON string array
  wholesaleDistributionLicense      String?
  /// See allowed values reference above.
  warehousingCapability             String?
  yearsInOperation                  Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("supplier_profiles")
}

/// Country-level presence — "all levels of specificity" per Lewis, so this
/// is Country- not just Region-grained (Region is always derivable via
/// Country.regionCode when a coarser view is useful). Many rows per org.
model SupplierCountryPresence {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  countryCode    String
  country        Country  @relation(fields: [countryCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime @default(now())

  @@unique([organizationId, countryCode])
  @@map("supplier_country_presence")
}

/// One row per product a supplier/manufacturer has published to the
/// marketplace. Links to the shared ProductMaster catalog when matched
/// (same mechanism ProductLine/ProjectLine use elsewhere) so a buyer's
/// search-and-add flow can resolve it against the same category taxonomy.
/// Not visible in search until isPublished is true.
model SupplierProduct {
  id                String    @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name              String
  description       String?   @db.NVarChar(Max)
  productMasterId   String?
  productMaster     ProductMaster? @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Category-specific spec values, same JSON-keyed-by-ProductAttributeDefinition
  /// pattern as ProjectLine/ProductLine.attributes — validated at the app
  /// layer against the matched category's definitions.
  specifications    String?   @db.NVarChar(Max)
  gtin              String?
  manufacturerPartNumber String?
  isPublished       Boolean   @default(false)
  createdById       String?
  createdBy         User?     @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  /// Opposite side of SupplierLead.supplierProduct — required by Prisma even
  /// though nothing here navigates supplier->leads directly today (that read
  /// goes through SupplierDirectoryService, same pattern as the RLS-skipped
  /// access on this table's parent model). Missing this broke `prisma
  /// generate` outright (P1012) as of the commit that added SupplierLead —
  /// caught via CI failing on every push since, not by re-reading the schema.
  leads             SupplierLead[]

  @@index([organizationId])
  @@index([productMasterId])
  @@map("supplier_products")
}

/// A lightweight audit trail of buyer interest — created when a buying
/// organization selects a SupplierProduct into one of their own projects
/// (see OrganizationsService's future supplier-directory endpoints). Lets
/// the Supplier Portal show engagement without giving the supplier the
/// buyer's full record — buyerOrganizationId is stored (suppliers should be
/// able to see WHO is interested, that's the point of exposure), but never
/// gives the supplier write/read access into the buyer's own tenant data.
model SupplierLead {
  id                 String   @id @default(uuid())
  supplierOrganizationId String
  supplierOrganization   Organization @relation("SupplierLeadSupplier", fields: [supplierOrganizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  buyerOrganizationId    String
  buyerOrganization      Organization @relation("SupplierLeadBuyer", fields: [buyerOrganizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplierProductId  String
  supplierProduct    SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt          DateTime @default(now())

  @@index([supplierOrganizationId])
  @@index([buyerOrganizationId])
  @@map("supplier_leads")
}

// ---------------------------------------------------------------------------
// Organization onboarding — category-specific detail tables (2026-09-26)
// See claude/org-onboarding-data-model.md for the field lists these
// implement and claude/admin-onboarding-intake-spec.md for the phased plan
// this is Phase 1 of (data model only — no intake form UI yet; today these
// get populated the same way Unimed's own onboarding pilot did, by a
// platform-staff member handing structured data to a provisioning script).
// One optional detail relation per Organization.type value — see
// Organization's own doc comment above these relations for how the two
// connect. List-shaped fields (e.g. "funders operated under") are stored as
// JSON-stringified string arrays in an NVarChar(Max) column, the same
// convention DataSharingConsent.scope already uses — not because it's ideal
// for querying, but because none of these are filtered/searched on yet;
// revisit if that changes.
// ---------------------------------------------------------------------------

/// Universal "countries of operation" — every Organization can operate in
/// several countries regardless of category, distinct from the single
/// countryOfRegistrationCode above. Not the same table as
/// SupplierCountryPresence, which is specifically the SUPPLIER-type
/// marketplace's "countries of distribution" (a narrower, publish-facing
/// concept) — this one is the general onboarding fact for any org type.
model OrganizationCountryPresence {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  countryCode    String
  country        Country  @relation(fields: [countryCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime @default(now())

  @@unique([organizationId, countryCode])
  @@map("organization_country_presence")
}

/// PROCUREMENT_SERVICE_AGENT detail — see org-onboarding-data-model.md's
/// "Procurement Service Agent" section. Piloted against real Unimed data in
/// unimed-onboarding-pilot.md; the field list here is that pilot's proven
/// content, not a first guess.
model ProcurementAgentProfile {
  id                           String    @id @default(uuid())
  organizationId               String    @unique
  organization                 Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fundersProgramsOperatedUnder String?   @db.NVarChar(Max) // JSON string array
  productCategoriesProcured    String?   @db.NVarChar(Max) // JSON string array
  clientTypesServed            String?   @db.NVarChar(Max) // JSON string array
  accreditations               String?   @db.NVarChar(Max) // JSON string array
  /// See allowed values reference above.
  logisticsCapability          String?
  yearsOperatingInRole         Int?
  /// Surfaced as a genuine gap during the Unimed pilot (not in the original
  /// field list) — see unimed-onboarding-pilot.md. Free text rather than a
  /// fully structured policy record; revisit if this needs to be queried on
  /// (e.g. "which agents have cover expiring soon").
  insuranceCoverSummary        String?   @db.NVarChar(Max)
  insuranceExpiryDate          DateTime?
  trackRecordSummary           String?   @db.NVarChar(Max)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  @@map("procurement_agent_profiles")
}

/// TENDERING_PURCHASING_BODY detail — see org-onboarding-data-model.md's
/// "Tendering & Purchasing Body" section.
model TenderingBodyProfile {
  id                             String   @id @default(uuid())
  organizationId                 String   @unique
  organization                   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// See allowed values reference above.
  bodyType                       String?
  fundingSources                 String?  @db.NVarChar(Max) // JSON string array
  hasDirectProcurementAuthority  Boolean?
  /// Whether this body runs its own tenders directly or hands that work to
  /// a procurement agent. Deliberately just a fact-capture field, NOT an
  /// access grant — see the 2026-09-26 decision in
  /// claude/stakeholder-taxonomy-research.md that a tendering body does NOT
  /// get visibility into an agent's project data even when this is true.
  /// This is the seed for that relationship being recorded at all, not the
  /// seed of a permission.
  usesExternalProcurementAgent   Boolean  @default(false)
  procurementAgentOrganizationId String?
  procurementAgentOrganization   Organization? @relation("TenderingBodyProcurementAgent", fields: [procurementAgentOrganizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  diseaseProgramAreas            String?  @db.NVarChar(Max) // JSON string array
  scaleServedSummary             String?  @db.NVarChar(Max)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@map("tendering_body_profiles")
}

/// MANUFACTURER detail — see org-onboarding-data-model.md's "Manufacturer"
/// section. Distinct from the shared marketplace SupplierProfile (which a
/// MANUFACTURER-type org also has, per B10's decision to reuse that table
/// for both MANUFACTURER and SUPPLIER) — this table holds the fields that
/// are ONLY meaningful for a manufacturer (regulatory approvals, production
/// capacity), same split as SupplierProfile's own new Supplier/Distributor
/// fields being manufacturer-irrelevant.
// ---------------------------------------------------------------------------
// Stakeholder registry — cross-tenant duplicate-prevention + identity
// consent (added 2026-10-02, per claude/sop-driven-quality-roadmap.md
// Section B3/C). NOT tenant-scoped and deliberately outside RLS, same
// reasoning as product_master (see row-level-security.sql's exclusion
// list) — nothing stored here is commercially sensitive, it is
// specifically the thin, shared subset of a stakeholder's identity that's
// safe for every organisation to see, so that:
//
//   (a) when Organisation B starts onboarding a manufacturer/supplier that
//       Organisation A (or the company itself) has already added, B gets
//       prompted with a safe preview and can link to the same record in
//       one click instead of re-typing everything and creating an
//       unrelated duplicate Partner; and
//   (b) a product's manufacturer/supplier name can only ever be revealed
//       in the Universe Product Database once there is a REAL, identified,
//       consenting company behind it (linkedOrganizationId set AND that
//       Organization's own SupplierProfile/ManufacturerProfile published)
//       — not just whatever name one tenant happened to type into their
//       own private Partner record.
//
// Every tenant-local Partner of a registrable stakeholder type (see
// Partner.registryEntryId) that refers to the same real-world company
// converges on one row here, found via PartnersService's matching logic
// (name/country/registration-number) when a Partner is created, or
// confirmed explicitly by a user from the duplicate-prevention prompt.
// ---------------------------------------------------------------------------

/// See the section header comment above for the full design rationale.
model StakeholderRegistryEntry {
  id   String @id @default(uuid())
  /// Same normalize() convention as Partner.normalizedName (lowercased,
  /// legal-suffix-stripped) — the primary fuzzy-matching key.
  normalizedName String
  /// As originally entered by whichever organisation (or the company
  /// itself) first created this entry — kept distinct from normalizedName
  /// so the lightbox/preview can show a real, readable name.
  legalName      String
  countryCode    String?
  website        String?
  /// Companies House (or equivalent national) reference — the strongest
  /// single matching signal when present, since it's an external
  /// identifier rather than a fuzzy name/country guess.
  registrationNumber String?
  /// A second strong, external matching signal alongside
  /// registrationNumber — equally unique to one company. Added 2026-10-03
  /// so autopopulate/duplicate-prevention also triggers off VAT number,
  /// not just name and registration number.
  vatNumber String?
  /// JSON string array of PartnerRole.roleType values this entry has ever
  /// been referenced as (e.g. ["MANUFACTURER","SUPPLIER"]) — a real-world
  /// company can be onboarded under more than one stakeholder type across
  /// different organisations, or even within one.
  stakeholderTypes String @db.NVarChar(Max)
  /// Set once/if this real-world company registers its own Universe
  /// organisation and the match is confirmed (reconciled automatically
  /// when that Organization publishes a SupplierProfile/ManufacturerProfile
  /// — see StakeholderRegistryService). This alone does not expose
  /// anything further; identity visibility in the Universe Product
  /// Database additionally requires that Organization's own profile to be
  /// published (publishedAt set) — see StakeholderRegistryService's
  /// isIdentityPublic().
  linkedOrganizationId String?
  linkedOrganization   Organization? @relation(fields: [linkedOrganizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partners Partner[]

  @@index([normalizedName])
  @@index([registrationNumber])
  @@index([vatNumber])
  @@index([linkedOrganizationId])
  @@map("stakeholder_registry_entries")
}

model ManufacturerProfile {
  id                             String   @id @default(uuid())
  organizationId                 String   @unique
  organization                   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productCategoriesManufactured  String?  @db.NVarChar(Max) // JSON string array
  /// WHO Prequalification status — see ProductSourceStandard's doc comment
  /// in enums.ts for why WHO PQ *product* data isn't imported yet; this is
  /// a separate, simpler fact about the manufacturer itself, not the data
  /// import question.
  whoPrequalified                Boolean  @default(false)
  sraApprovals                   String?  @db.NVarChar(Max) // JSON string array — which Stringent Regulatory Authorities
  nationalRegistrations          String?  @db.NVarChar(Max) // JSON string array of country codes
  otherCertifications            String?  @db.NVarChar(Max) // JSON string array
  productionCapacitySummary      String?  @db.NVarChar(Max)
  currentExportMarkets           String?  @db.NVarChar(Max) // JSON string array of country codes
  /// The active African local-manufacturing policy push flagged in
  /// stakeholder-taxonomy-research.md section 1e — a simple flag rather
  /// than modeling policy eligibility rules, which are out of scope here.
  isLocalManufacturer            Boolean  @default(false)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  @@map("manufacturer_profiles")
}

/// One row per manufacturing site — a manufacturer can have several, each
/// independently certified, per org-onboarding-data-model.md. Many-to-one
/// with Organization (not 1:1 like the profile tables above).
model OrganizationManufacturerSite {
  id                     String   @id @default(uuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locationCountryCode    String?
  locationCountry        Country? @relation(fields: [locationCountryCode], references: [code], onDelete: NoAction, onUpdate: NoAction)
  locationDetail         String?
  gmpCertified           Boolean  @default(false)
  gmpCertificationDetail String?  @db.NVarChar(Max)
  createdAt              DateTime @default(now())

  @@index([organizationId])
  @@map("manufacturer_sites")
}

/// FUNDER_DONOR detail — deliberately minimal. Unlike the other five detail
/// tables, this one has NO proven field list behind it: FUNDER_DONOR was
/// added to the taxonomy after org-onboarding-data-model.md was written, and
/// what a funder can actually see/do is explicitly undesigned (see
/// stakeholder-taxonomy-research.md's "Decisions" section). Two loose
/// fields only, so a FUNDER_DONOR org has somewhere for basic context to
/// live without pretending a real field list exists yet. Expect this table
/// to change shape once that design pass happens.
model FunderProfile {
  id                String   @id @default(uuid())
  organizationId    String   @unique
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fundingFocusAreas String?  @db.NVarChar(Max) // JSON string array
  notes             String?  @db.NVarChar(Max)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("funder_profiles")
}

/// DATA_INSIGHTS_USER detail — see org-onboarding-data-model.md's
/// "Data / Insights User" section. `dataUseAgreementVersion`/
/// `dataUseAgreementAcceptedAt` are a deliberately simplified stand-in for
/// what that doc calls "likely a variant of DataSharingConsent scoped to
/// consuming, not contributing, data" — a full second consent model wasn't
/// worth building before any Data/Insights org actually exists on the
/// platform; revisit if/when one does.
model DataInsightsUserProfile {
  id                         String    @id @default(uuid())
  organizationId             String    @unique
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// See allowed values reference above.
  institutionType            String?
  affiliatedInstitution      String?
  purposeIntendedUse         String?   @db.NVarChar(Max)
  publicationIntent          String?   @db.NVarChar(Max)
  fundingSourceOfResearch    String?
  dataUseAgreementVersion    String?
  dataUseAgreementAcceptedAt DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@map("data_insights_user_profiles")
}

// ---------------------------------------------------------------------------
// Compliance scaffolding — added 2026-10-07, see
// claude/compliance-standards-gap-analysis.md. Generic, organisation-
// agnostic infrastructure (same "core scaffolding, not org-specific
// process bloat" principle sop-driven-quality-roadmap.md already
// established for the Evidence work), not features tied to any one
// stakeholder's SOPs.
// ---------------------------------------------------------------------------

/// Gap 1 — a generic, field-level audit trail. ALCOA+/FDA 21 CFR Part 11/
/// EU Annex 11/MHRA GxP Data Integrity Guidance all require that a changed
/// or deleted value's PREVIOUS state be retained, attributable to a
/// specific individual, timestamped, and (where relevant) carry a reason —
/// a bare `updatedAt` column satisfies none of that, since the prior value
/// is simply gone. Before this, the only tables with any change history at
/// all were ProjectStatusHistory (status field only) and
/// PartnerApprovalHistory (approval decisions only, and — see that
/// model's own fix above — not even written to by any service yet).
///
/// Deliberately ONE ROW PER CHANGED FIELD, not one row per request/mutation
/// — so "every past value of this one field" is a simple, indexed query
/// (tableName + recordId + fieldName) rather than a scan through
/// differently-shaped per-request snapshots. Written from the shared
/// `recordFieldChanges()` helper (apps/api/src/common/audit-log.ts) inside
/// the SAME withTenantContext transaction as the write it's auditing, so a
/// rolled-back write can never leave an orphaned log entry (or vice versa).
///
/// Never updated or deleted by application code once written — there is
/// deliberately no update/delete path in the service layer for this model,
/// which is itself the "audit trail cannot be disabled by standard users"
/// control MHRA's guidance calls for. (A genuinely separate, future
/// platform-staff-only correction mechanism, if one is ever needed, should
/// be a NEW row referencing the old one, never an edit/delete of history.)
model FieldChangeLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// The Prisma @@map table name being audited, e.g. "projects",
  /// "project_lines", "partners" — free text by design (not an enum),
  /// since this log is meant to cover every tenant table over time
  /// without a schema change each time a new one is wired in.
  tableName      String
  recordId       String
  fieldName      String
  /// Stringified before/after values (Dates as ISO, numbers/decimals via
  /// their own toString()) — see diffForAudit()'s normalize() helper. Not
  /// typed per-field on purpose: a generic log can't know every table's
  /// column types, and a human-readable string is sufficient for an audit
  /// review, which is this table's entire purpose.
  oldValue       String?      @db.NVarChar(Max)
  newValue       String?      @db.NVarChar(Max)
  changedById    String?
  changedAt      DateTime     @default(now())
  /// Free-text reason, where the caller supplied one (not every change
  /// has or needs one — a required-reason policy, if wanted, belongs in
  /// the DTO/service layer, not enforced here).
  reason         String?      @db.NVarChar(Max)
  /// UI | API | MIGRATION | SYSTEM — which path produced this change.
  /// Defaults to "API" (recordFieldChanges()'s default) since that's the
  /// only path wired in today; MIGRATION/SYSTEM are reserved for a
  /// one-off backfill or scheduled job that changes data without a human
  /// request behind it.
  source         String       @default("API")
  /// Gap 2 — when this row represents an approval/verification action
  /// ("e-signature" in Part 11/Annex 11 terms), the exact certification
  /// statement text shown to the signer at that moment, captured verbatim.
  /// Null for an ordinary field edit with no certification semantics.
  certificationStatement String? @db.NVarChar(Max)

  @@index([organizationId])
  @@index([tableName, recordId])
  @@index([changedAt])
  @@map("field_change_log")
}

/// Gap 4 — a minimal, generic risk-assessment record (ICH Q9 Quality Risk
/// Management / ISO 14971 / ISO 31000's shared shape: identify, assess,
/// mitigate, assign an owner, review periodically). Deliberately NOT the
/// full Deviation/CAPA/Recall process-management suite the first draft of
/// sop-driven-quality-roadmap.md proposed and then dropped as "Unimed's
/// own SOP-driven process, not core platform" — this is lighter-weight
/// core scaffolding any organisation can use for its own risk register,
/// the same way EvidenceStandardDefinition generalised certification
/// tracking rather than hardcoding Unimed's own list.
model RiskAssessment {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// What this risk is about — a free-text subject type ("PARTNER",
  /// "PROJECT", "PRODUCT_BATCH", ...) + id pair, the same
  /// generic-polymorphic-reference convention as FieldChangeLog's
  /// tableName/recordId, rather than a nullable FK per possible subject
  /// (which would need a schema change every time a new subject type
  /// comes up).
  subjectType    String
  subjectId      String
  title          String
  description    String?      @db.NVarChar(Max)
  /// LOW | MEDIUM | HIGH | CRITICAL — free text for now, same convention
  /// as Partner.riskTier, rather than a hardcoded enum.
  severity       String
  /// LOW | MEDIUM | HIGH — likelihood of the risk materialising.
  likelihood     String
  /// Free-text mitigation/control plan.
  mitigation     String?      @db.NVarChar(Max)
  ownerId        String?
  owner          User?        @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// OPEN | MITIGATED | ACCEPTED | CLOSED.
  status         String       @default("OPEN")
  reviewDate     DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([subjectType, subjectId])
  @@index([reviewDate])
  @@map("risk_assessments")
}

/// Gap 7 (compliance-standards-gap-analysis.md) — a minimal controlled-
/// document register for an organisation's own SOPs/policies: the
/// artifacts this whole GDP/compliance build exists to let a stakeholder
/// evidence compliance AGAINST, but which Universe itself had no module
/// to version-control as living documents. Deliberately thin — version
/// number, effective date, an approval attribution, and a supersedes/
/// supersededBy chain for current-vs-superseded state — not a general
/// document-management system with check-in/check-out or review
/// workflows, same "core scaffolding, not a full process suite"
/// principle as every other gap closed in this build.
model ControlledDocument {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title          String
  /// Free text, same convention as EvidenceStandardDefinition.category —
  /// e.g. "QUALITY_MANUAL", "SOP", "POLICY", "WORK_INSTRUCTION".
  category       String
  /// Free-text version label (e.g. "1.0", "2.3", "v4") rather than a
  /// strict semver — Unimed's own SOPs are versioned inconsistently
  /// today, and this register is meant to record what an organisation
  /// actually calls its own version, not impose a new scheme on it.
  version        String
  effectiveDate  DateTime?
  /// The prior version this one replaces, and the reverse pointer — a
  /// one-directional chain per document lineage, same self-relation
  /// convention as User.invitedBy/invitedUsers above. supersededById is
  /// set on the OLD row when a NEW version is created referencing it via
  /// supersedesId, keeping "is this the current version" a simple null
  /// check (isCurrent = supersededById === null) rather than a separate
  /// status field that could drift out of sync with the chain itself.
  supersedesId    String?              @unique
  supersedes      ControlledDocument?  @relation("ControlledDocumentSupersedes", fields: [supersedesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersededBy    ControlledDocument?  @relation("ControlledDocumentSupersedes")
  approvedById   String?
  approvedBy     User?        @relation(fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedAt     DateTime?
  /// Optional link to the actual file (Blob Storage, same as every other
  /// document reference in the schema) — nullable since a register entry
  /// can exist (e.g. recording a historical version) before or without
  /// the file itself being uploaded.
  documentId     String?
  document       ProjectDocument? @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, category])
  @@map("controlled_documents")
}

// ---------------------------------------------------------------------------
// GDP gap-closing build (added 2026-10-07) — closes the two gaps identified
// as genuinely missing for Good Distribution Practice in
// claude/compliance-standards-gap-analysis.md's "GDP compliance assessment"
// addendum, both already fully designed in sop-driven-quality-roadmap.md:
//
// Gap 3 — Standards & Evidence scaffolding: EvidenceStandardDefinition +
// StakeholderEvidenceRecord, replacing the hardcoded PartnerCertification/
// PartnerCompanyCheck type lists with a per-organisation configurable
// catalog, and gating Partner.approvalStatus on mandatory evidence being
// VERIFIED. (The roadmap doc also proposed a separate OnboardingRequirementSet
// table; deliberately NOT built as its own table here — a "requirement set"
// for a stakeholder type is just EvidenceStandardDefinition rows filtered by
// appliesToStakeholderTypes + isMandatory for the org, so a materialized
// join table would only duplicate that filter, not add new information. See
// EvidenceService.getApplicableStandards/getGateStatus.)
//
// Gaps 5/6 — batch traceability + cold-chain temperature logging:
// ProductBatch promotes the batch from a free-text field on ProjectLine to
// a first-class, searchable entity; BatchTemperatureLog gives data-logger
// readings/excursions their own child table instead of one flat field per
// line. Carrier/route qualification (also named in Gap 5) is deliberately
// NOT a new table — it's modeled as an EvidenceStandardDefinition row
// scoped to the FREIGHT_FORWARDER stakeholder type (category REGULATORY,
// with reVerificationFrequencyMonths driving requalification), reusing Gap
// 3's infrastructure rather than building a second, parallel mechanism for
// the same "qualified until a date, then needs re-checking" shape.
// ---------------------------------------------------------------------------

/// Gap 3 — the configurable catalog of standards/evidence an organisation
/// can require from its stakeholders. Replaces the hardcoded allowed-value
/// lists on PartnerCertification.type/PartnerCompanyCheck.checkType with a
/// real, per-organisation, admin-editable table — Unimed's current MHRA/
/// GDP/ISO/WHO-MQAS requirements become the first seeded rows, not a
/// blueprint baked into code for every tenant. See
/// sop-driven-quality-roadmap.md "Proposed core scaffolding", item 1.
model EvidenceStandardDefinition {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  description    String?      @db.NVarChar(Max)
  /// QUALITY | BUSINESS | FINANCIAL | REGULATORY | INSURANCE | OTHER — see
  /// EvidenceStandardCategory in packages/db/src/enums.ts.
  category       String
  /// Comma-joined PartnerRoleType values this standard applies to (e.g.
  /// "MANUFACTURER,SUPPLIER") — same multiselect-as-comma-joined-string
  /// convention as ClientDetail.productCategoryLicenses, since the SQL
  /// Server connector has no native array/set column type.
  appliesToStakeholderTypes String  @db.NVarChar(Max)
  /// DOCUMENT | CHECK — see EvidenceType in packages/db/src/enums.ts;
  /// drives which fields the frontend's "log evidence" form shows.
  evidenceType   String
  /// Drives gating: Partner.approvalStatus cannot move to APPROVED while
  /// any isMandatory standard applicable to that partner's active roles
  /// has no StakeholderEvidenceRecord with status VERIFIED (and, if
  /// requiresExpiry, a non-expired one) — see EvidenceService.getGateStatus.
  isMandatory    Boolean      @default(true)
  requiresExpiry Boolean      @default(false)
  /// When set, a VERIFIED record against this standard is flagged as due
  /// for re-verification this many months after its own verifiedAt — the
  /// generic mechanism behind "annual Bona Fide recheck", "annual customer
  /// requalification", and freight-forwarder route requalification alike,
  /// rather than a bespoke field/feature per case.
  reVerificationFrequencyMonths Int?
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  evidenceRecords StakeholderEvidenceRecord[]

  @@index([organizationId])
  @@index([organizationId, active])
  @@map("evidence_standard_definitions")
}

/// Gap 3 — one logged piece of evidence against a standard, for one
/// partner. Generalises PartnerCertification (DOCUMENT shape) and
/// PartnerCompanyCheck (CHECK shape) into a single table keyed to a
/// catalog row instead of a hardcoded type string. Existing
/// PartnerCertification/PartnerCompanyCheck rows are NOT migrated into
/// this table by this change — both tables stay exactly as they are for
/// Unimed's existing data (see sop-driven-quality-roadmap.md's suggested
/// build order, item 5, for the planned follow-up migration); this is the
/// new write path going forward, usable immediately for any standard an
/// org adds to its own catalog.
model StakeholderEvidenceRecord {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partnerId      String
  partner        Partner      @relation(fields: [partnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  standardId     String
  standard       EvidenceStandardDefinition @relation(fields: [standardId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referenceNumber String?
  issuingBody    String?
  issuedDate     DateTime?
  expiryDate     DateTime?
  /// Only meaningful for evidenceType == CHECK — YES | NO | NOT_APPLICABLE,
  /// same convention as PartnerCompanyCheck.result.
  result         String?
  documentId     String?
  document       ProjectDocument? @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// PENDING | VERIFIED | EXPIRED | REJECTED — see EvidenceRecordStatus.
  status         String       @default("PENDING")
  verifiedById   String?
  verifiedAt     DateTime?
  notes          String?      @db.NVarChar(Max)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([partnerId])
  @@index([standardId])
  @@index([expiryDate])
  @@map("stakeholder_evidence_records")
}

/// Gaps 5/6 — promotes a product batch from a free-text field on
/// ProjectLine to a first-class, searchable, tenant-scoped entity, so
/// "every place batch X was shipped, and was it kept in spec" is one
/// indexed query instead of a manual text search across project lines.
/// See sop-driven-quality-roadmap.md "Full batch-level traceability for
/// pharma projects".
model ProductBatch {
  id                              String        @id @default(uuid())
  organizationId                  String
  organization                    Organization  @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productMasterId                 String?
  productMaster                   ProductMaster? @relation(fields: [productMasterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manufacturerId                  String?
  manufacturer                    Partner?      @relation(fields: [manufacturerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batchNumber                     String
  manufacturedDate                DateTime?
  expiryDate                      DateTime?
  storageConditions               String?
  /// Which regulatory pathway qualified this batch — same allowed values
  /// as ProjectLine.qualificationPathway (WHO PQ / SRA / ERP), moved here
  /// as the canonical per-batch record rather than re-entered per line.
  qualificationPathway            String?
  qualificationPathwayExpiryDate  DateTime?
  /// Marketing Authorization / Product License number.
  maPl                            String?
  /// ACTIVE | QUARANTINED | EXPIRED | WITHDRAWN — see ProductBatchStatus.
  /// Tracked once per batch instead of per line, so quarantining a batch
  /// is a single update that's visible everywhere that batch is referenced.
  status                          String        @default("ACTIVE")
  notes                           String?       @db.NVarChar(Max)
  createdById                     String?
  createdAt                       DateTime      @default(now())
  updatedAt                       DateTime      @updatedAt

  projectLines      ProjectLine[]
  temperatureLogs   BatchTemperatureLog[]

  @@index([organizationId])
  @@index([organizationId, batchNumber])
  @@index([productMasterId])
  @@index([manufacturerId])
  @@index([status])
  @@map("product_batches")
}

/// Gaps 5/6 — one data-logger reading/excursion event against a batch.
/// Previously a single flat dataLoggerReference/dataLoggerReportReviewed/
/// excursionReview field-set per ProjectLine, which could not hold more
/// than one logger event per shipment; this gives cold-chain monitoring
/// its own child table, scoped to the batch (the WHO/EU GDP-relevant unit)
/// rather than the commercial line.
model BatchTemperatureLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productBatchId String
  productBatch   ProductBatch @relation(fields: [productBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Optional — which specific shipment/delivery this reading belongs to,
  /// when the batch has been linked to one or more ProjectLines.
  projectLineId  String?
  loggerReference String?
  /// Free-text summary of the logger's reading/report for now (e.g. "2-8C
  /// maintained throughout, no excursions" or "+11C for 40min at hr 6") —
  /// a structured min/max/duration time-series is a larger, separate
  /// build (full IoT logger ingestion) this doesn't attempt.
  readingSummary String?      @db.NVarChar(Max)
  hasExcursion   Boolean      @default(false)
  excursionNotes String?      @db.NVarChar(Max)
  reviewed       Boolean      @default(false)
  reviewedById   String?
  reviewedAt     DateTime?
  recordedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([productBatchId])
  @@map("batch_temperature_logs")
}
