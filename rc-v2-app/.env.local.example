# ─────────────────────────────────────────────────────────────
# Renewables Connect V2 — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Azure AD B2C Authentication ───────────────────────────────
# Found in: Azure Portal → Azure AD B2C → App Registrations
NEXT_PUBLIC_AZURE_AD_B2C_TENANT_NAME=renewablesconnect      # e.g. renewablesconnect (without .onmicrosoft.com)
NEXT_PUBLIC_AZURE_AD_B2C_CLIENT_ID=your-app-client-id-here
NEXT_PUBLIC_AZURE_AD_B2C_POLICY_NAME=B2C_1_signupsignin     # Your sign-up/sign-in policy name

# ── Sanity CMS ────────────────────────────────────────────────
# Found in: sanity.io → Project Settings
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-sanity-api-token                       # Server-side only (mutations)

# ── Azure Blob Storage ────────────────────────────────────────
NEXT_PUBLIC_AZURE_CDN_BASE_URL=https://your-cdn.azureedge.net

# ── Azure Functions API ───────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://your-functions.azurewebsites.net/api
